<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="4">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="27">
          <value>grnnotransaksi,System.String</value>
          <value>grnid,System.Int64</value>
          <value>grntgl,System.DateTime</value>
          <value>grnsupplier,System.String</value>
          <value>gudang,System.String</value>
          <value>grnuraian,System.String</value>
          <value>grnstatus,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>harga,System.Double</value>
          <value>satuan,System.String</value>
          <value>total,System.Double</value>
          <value>jmldiskon,System.Double</value>
          <value>totalpajak,System.Double</value>
          <value>totaltransaksi,System.Double</value>
          <value>kurs,System.Double</value>
          <value>totalfungsional,System.Double</value>
          <value>jmldiskonfungsional,System.Double</value>
          <value>totalpajakfungsional,System.Double</value>
          <value>totaltransaksifungsional,System.Double</value>
          <value>jmlrealisasi,System.Double</value>
          <value>sisa,System.Double</value>
          <value>kkategorisupplier,System.String</value>
          <value>rinotransaksi,System.String</value>
          <value>prtgldipakai,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	grn.grnnotransaksi , 
	grn.grnid , 
	grn.grntgl , 
	ks.knama AS grnsupplier ,
	w.wnama as gudang , 
	grn.grnuraian , 
	st.nama AS grnstatus , 

	b.bkode , 
	grnd.namabarang , 
	grnd.catatan , 
	grnd.jml , 
	grnd.harga,
	grnd.satuan , 
	grnd.jml * grnd.harga AS total,
	grnd.jmldiskon,
	grnd.jmlpajak1 + grnd.jmlpajak2 AS totalpajak,
	((grnd.jml * grnd.harga) - grnd.jmldiskon + (grnd.jmlpajak1 + grnd.jmlpajak2)) AS totaltransaksi ,
	grnd.kurs,
	((grnd.jml - ifnull(SUM(rid.jml),0)) * grnd.harga * grnd.kurs) AS totalfungsional,
	(((grnd.jmldiskon * grnd.kurs) / grnd.jml) * (grnd.jml - ifnull(SUM(rid.jml),0))) as jmldiskonfungsional,
	((((grnd.jmlpajak1 + grnd.jmlpajak2) * grnd.kurs) / grnd.jml) * (grnd.jml - ifnull(SUM(rid.jml),0))) AS totalpajakfungsional,
	((grnd.jml - ifnull(SUM(rid.jml),0)) * grnd.harga * grnd.kurs) - (((grnd.jmldiskon * grnd.kurs) / grnd.jml) * (grnd.jml - ifnull(SUM(rid.jml),0))) + ((((grnd.jmlpajak1 + grnd.jmlpajak2) * grnd.kurs) / grnd.jml) * (grnd.jml - ifnull(SUM(rid.jml),0))) AS totaltransaksifungsional ,

	ifnull(SUM(rid.jml),0) AS jmlrealisasi , 
	(grnd.jml - ifnull(SUM(rid.jml),0)) as sisa , 
	ks.kkategorisupplier , 

	IFNULL(ri.rinotransaksi,'') as rinotransaksi,
	pr.prtgldipakai


	FROM
	m4_grn grn
JOIN m4_grn_detail grnd ON grn.grnid = grnd.idgrn
JOIN m1_contact ks ON grn.grnsupplier = ks.kid
JOIN m1_item b ON grnd.idbarang = b.bid
JOIN m1_warehouse w ON grn.grngudang = w.wkode
JOIN m0_status st ON grn.grnstatus = st.kode

LEFT JOIN m1_supplier_category sc ON ks.kkategorisupplier = sc.sckode

LEFT JOIN m4_ri_detail rid ON grnd.idgrndetail = rid.idgrndetail 
LEFT JOIN m4_ri ri ON rid.idri = ri.riid 

LEFT JOIN m4_po_detail pod ON grnd.idpodetail = pod.idpodetail
LEFT JOIN m4_pr_detail prd ON pod.idprdetail = prd.idprdetail
LEFT JOIN m4_pr pr ON prd.idpr = pr.prid

WHERE
grn.grnstatus IN (2,3)	

GROUP BY grnd.idgrndetail	
ORDER BY grn.grntgl , grn.grnid , grn.grnnotransaksi , grnd.urutan
</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
