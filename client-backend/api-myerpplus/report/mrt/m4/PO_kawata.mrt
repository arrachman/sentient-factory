          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>jmldiskon,System.Double</value>
          <value>pojmldiskon,System.Double</value>
          <value>pototalpajak1detail,System.Double</value>
          <value>pobiayalain,System.Double</value>
          <value>prnotransaksi,System.String</value>
          <value>pruraian,System.String</value>
          <value>customdate1,System.DateTime</value>
          <value>nama,System.String</value>
          <value>costcenter,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	po.potgldipenuhi , 
	po.pototaltransaksi , 
	po.potermin , po.potgljatuhtempo , 

	pohargatermasukpajak, 
	CASE pohargatermasukpajak
	WHEN 0 THEN "Belum Termasuk Pajak"
	WHEN 1 THEN "Sudah Termasuk Pajak"
END AS "caption" , 
pod.matauang , 


po.po1alamat1 , 
po.po2alamat1 AS alamatkirim , 
ksup.kkontakperson , 

ksup.kkode AS kodesupplier , 
ksup.knama AS posupplier, 
ksup.k1alamat1 , 
ksup.k1notelp1 , 
ksup.k1nofax , 

po.pomatauang, 
po.pokurs, 
po.potgl, 
po.ponotransaksi, 
st.nama AS postatus, 
po.pouraian , 
po.pocatatan , 

b.bkode, 
pod.namabarang , 
pod.jml, 
pod.satuan, 
pod.diskon, 
pod.harga, 
((pod.jml * pod.harga) - pod.jmldiskon) as total , 
pod.jmldiskon, 
po.pojmldiskon, 
po.pototalpajak1detail, 
po.pobiayalain , 

pr.prnotransaksi ,
pr.pruraian, 
pod.customdate1 , 
stt.nama  ,
pod.costcenter


FROM m4_po po
JOIN m4_po_detail pod ON po.poid = pod.idpo
JOIN m1_item b ON pod.idbarang = b.bid
JOIN m1_contact ksup ON po.posupplier = ksup.kid
JOIN m0_status st ON po.postatus = st.kode

LEFT JOIN m4_pr_detail prd ON pod.idprdetail = prd.idprdetail 
LEFT JOIN m4_pr pr ON prd.idpr = pr.prid

JOIN m0_status stt ON po.postatus = stt.kode 

WHERE po.ponotransaksi = "KIPO17080106"

ORDER BY po.potgl, po.ponotransaksi, pod.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
