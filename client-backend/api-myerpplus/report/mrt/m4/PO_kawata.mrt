      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="38">
          <value>potgldipenuhi,System.DateTime</value>
          <value>pototaltransaksi,System.Double</value>
          <value>potermin,System.String</value>
          <value>potgljatuhtempo,System.DateTime</value>
