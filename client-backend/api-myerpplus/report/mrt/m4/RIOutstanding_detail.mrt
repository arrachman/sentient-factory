<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="9">
          <value>rinotransaksi,System.String</value>
          <value>riid,System.Int64</value>
          <value>ritgl,System.DateTime</value>
          <value>risupplier,System.String</value>
          <value>riuraian,System.String</value>
          <value>ristatus,System.String</value>
          <value>kkategorisupplier,System.String</value>
          <value>ritotaltransaksi,System.Double</value>
          <value>rinoref,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 

	ri.rinotransaksi , 
	ri.riid , 
	ri.ritgl , 
	ks.knama AS risupplier , 
	ri.riuraian, 
	st.nama AS ristatus , 
	ks.kkategorisupplier , ri.ritotaltransaksi 

	FROM m4_ri ri 
JOIN m1_contact ks ON ri.risupplier = ks.kid 
JOIN m0_status st ON ri.ristatus = st.kode
LEFT JOIN m1_supplier_category sc ON ks.kkategorisupplier = sc.sckode

ORDER BY ri.ritgl , ri.rinotransaksi

limit 6</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <DS2 Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="13">
          <value>vpnotransaksi,System.String</value>
          <value>sumber,System.String</value>
          <value>idtransaksi,System.Int64</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
          <value>matauang,System.String</value>
          <value>riid,System.Int64</value>
          <value>ritgl,System.DateTime</value>
          <value>rinotransaksi,System.String</value>
          <value>ritotaltransaksi,System.Double</value>
          <value>rimatauang,System.String</value>
          <value>sisa,System.Double</value>
          <value>no,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	vp.vpnotransaksi , 
	vpd.sumber , 
	vpd.idtransaksi , 
	SUM(vpd.jmlbayar) AS jmlbayar , 
	SUM(vpd.jmlbayarvalas) AS jmlbayarvalas , 
	vpd.matauang , 

	ri.riid , 
	ri.ritgl , 
	ri.rinotransaksi , 
	ri.ritotaltransaksi , 
	ri.rimatauang , 
	(ri.ritotaltransaksi - SUM(vpd.jmlbayarvalas)) AS sisa , 

	(
	SELECT 

GROUP_CONCAT(vp2.vpnotransaksi)

FROM m4_vp vp2 
JOIN m4_vp_detail vpd2 ON vp2.vpid = vpd2.idvp 
JOIN m4_ri ri2 ON vpd2.idtransaksi = ri2.riid AND vpd2.sumber = ri2.risumber 

WHERE vpd2.sumber = "RI" 
AND ri.riid = ri2.riid

GROUP BY ri2.riid 
) as no 

FROM m4_vp vp 
JOIN m4_vp_detail vpd ON vp.vpid = vpd.idvp 
JOIN m4_ri ri ON vpd.idtransaksi = ri.riid AND vpd.sumber = ri.risumber 


WHERE vpd.sumber = "RI" 


GROUP BY ri.riid 
ORDER BY ri.riid ASC , vp.vpid ASC</SqlCommand>
      </DS2>
      <formatNominal Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
