  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-berliando</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="7">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>idbarang,System.Int64</value>
          <value>grnid,System.Int64</value>
          <value>grntgl,System.DateTime</value>
          <value>grnnotransaksi,System.String</value>
          <value>grncustomerkode,System.String</value>
          <value>grncustomer,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>bavolume,System.String</value>
          <value>kkode,System.String</value>
          <value>knama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	grnd.idbarang , 
	grn.grnid , 
	grn.grntgl , 
	grn.grnnotransaksi ,
	kc.kkode AS grncustomerkode , 
	kc.knama AS grncustomer ,	
	b.bkode ,
	grnd.namabarang , 
	grnd.jml , 
	grnd.satuan ,
	b.bavolume ,
	ks.kkode,
	ks.knama
	FROM
	m4_grn grn
JOIN m1_contact kc ON grn.grnsupplier = kc.kid
JOIN m4_grn_detail grnd ON grn.grnid = grnd.idgrn
JOIN m1_item b on grnd.idbarang = b.bid
LEFT JOIN m1_item_supplier isp ON b.bid = isp.isidbarang
LEFT JOIN m1_contact ks ON isp.isidkontak = ks.kid

WHERE (Grnnotransaksi BETWEEN "5171GRN19100900" AND "5171GRN19100900") 
AND (Grnlokasi LIKE "%L-5171%") 
AND (Grncabang LIKE "%51%") 


GROUP BY grn.grnnotransaksi , grnd.idbarang 
ORDER BY grn.grntgl , grn.grnid, grn.grnnotransaksi , grnd.urutan

</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="11">
          <value>grnid,System.Int64</value>
          <value>grnnotransaksi,System.String</value>
          <value>idgrn,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>nstidbarang,System.Int64</value>
          <value>nstkode,System.String</value>
          <value>jmlserial,System.Double</value>
          <value>satuan,System.String</value>
          <value>nstcustomdate1,System.DateTime</value>
          <value>jml,System.Double</value>
          <value>nstid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	grn.grnid , 
	grn.grnnotransaksi ,
	grnd.idgrn ,
	grnd.idbarang ,
	grnd.jml ,	
	nst.nstid ,
	nst.nstidbarang , 
	nst.nstkode , 
	nst.nstjml AS jmlserial, 
	nst.nstsatuan AS satuan,
	nst.nstcustomdate1 

	FROM m4_grn grn
JOIN m4_grn_detail grnd ON grn.grnid = grnd.idgrn
JOIN m1_no_serial_transaction nst ON grn.grnsumber = nst.nstsumber AND grn.grnid = nst.nstidtransaksi AND grnd.idbarang = nst.nstidbarang 


WHERE (Grnnotransaksi BETWEEN "5171GRN19100900" AND "5171GRN19100900") 
AND (Grnlokasi LIKE "%L-5171%") 
AND (Grncabang LIKE "%51%") 

GROUP BY nst.nstid

ORDER BY grn.grntgl , grn.grnid, grn.grnnotransaksi , grnd.idbarang,  grnd.urutan</SqlCommand>
      </DS2>
      <DS3 Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="11">
          <value>grnid,System.Int64</value>
          <value>grnnotransaksi,System.String</value>
          <value>idgrn,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>nbtidbarang,System.Int64</value>
          <value>nbtkode,System.String</value>
          <value>jmlbatch,System.Double</value>
          <value>satuan,System.String</value>
          <value>nbtcustomdate1,System.DateTime</value>
          <value>jml,System.Double</value>
          <value>nbtid,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	grn.grnid , 
	grn.grnnotransaksi ,
	grnd.idgrn ,
	grnd.idbarang ,
	grnd.jml ,	
	nbt.nbtid ,
	nbt.nbtidbarang , 
	nbt.nbtkode , 
	nbt.nbtjml AS jmlbatch, 
	nbt.nbtsatuan AS satuan,
	nbt.nbtcustomdate1

	FROM m4_grn grn
JOIN m4_grn_detail grnd ON grn.grnid = grnd.idgrn
JOIN m1_no_batch_transaction nbt ON grn.grnsumber = nbt.nbtsumber AND grn.grnid = nbt.nbtidtransaksi AND grnd.idbarang = nbt.nbtidbarang

WHERE (Grnnotransaksi BETWEEN "5171GRN19100900" AND "5171GRN19100900") 
AND (Grnlokasi LIKE "%L-5171%") 
AND (Grncabang LIKE "%51%") 

GROUP BY nbt.nbtidtransaksi, nbt.nbtidbarang , nbt.nbtkode , grnd.idgrndetail


ORDER BY grn.grntgl , grn.grnid, grn.grnnotransaksi , grnd.idbarang,  grnd.urutan, nbt.nbtid</SqlCommand>
      </DS3>
