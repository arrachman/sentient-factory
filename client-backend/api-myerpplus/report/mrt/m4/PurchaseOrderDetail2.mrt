<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString />
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="30">
          <value>terbilang,System.String</value>
          <value>pohargatermasukpajak,System.Int16</value>
          <value>caption,System.String</value>
          <value>posupplier,System.String</value>
          <value>pomatauang,System.String</value>
          <value>pokurs,System.Double</value>
          <value>potgl,System.DateTime</value>
          <value>ponotransaksi,System.String</value>
          <value>postatus,System.String</value>
          <value>pouraian,System.String</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>pojmldiskon,System.Double</value>
          <value>pototalpajak1detail,System.Double</value>
          <value>pobiayalain,System.Double</value>
          <value>pototaltransaksi,System.Double</value>
          <value>kkontakperson,System.String</value>
          <value>po2alamat1,System.String</value>
          <value>po1alamat1,System.String</value>
          <value>kodebarangsupplier,System.String</value>
          <value>satuannama,System.String</value>
          <value>prnotransaksi,System.String</value>
          <value>sigudang,System.String</value>
          <value>silokasi,System.String</value>
          <value>trcatatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	f_nominal(po.pototaltransaksi, po.pomatauang) AS terbilang , 

	pohargatermasukpajak, 
	CASE pohargatermasukpajak
	WHEN 0 THEN "Belum Termasuk Pajak"
	WHEN 1 THEN "Sudah Termasuk Pajak"
END AS "caption" , 

ksup.knama AS posupplier, 
po.pomatauang, 
po.pokurs, 
po.potgl, 
po.ponotransaksi, 
st.nama AS postatus, 
po.pouraian , 
po.pogudang AS sigudang,
po.polokasi AS silokasi,
po.pocatatan AS sicatatan ,
po.potermin AS sitermin ,
	t.trnama AS siterminnama ,
	t.trcatatan ,


b.bkode, 
b.bcustom1 AS kodebarangsupplier,
pod.namabarang , 
pod.jml, 
pod.satuan, 
u.unama as satuannama,
pod.diskon, 
pod.harga, 
((pod.jml * pod.harga) - pod.jmldiskon) as total , 


po.pojmldiskon, 
po.pototalpajak1detail, 
po.pobiayalain , 
po.pototaltransaksi , 
ksup.kkontakperson , 
po.po2alamat1 , 
po.po1alamat1 

FROM m4_po po
JOIN m4_po_detail pod ON po.poid = pod.idpo
JOIN m1_item b ON pod.idbarang = b.bid

LEFT JOIN m1_terms t ON po.potermin = t.trkode

JOIN m1_contact ksup ON po.posupplier = ksup.kid
JOIN m0_status st ON po.postatus = st.kode
JOIN m1_unit u ON pod.satuan = u.ukode


ORDER BY po.potgl, po.ponotransaksi, pod.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
