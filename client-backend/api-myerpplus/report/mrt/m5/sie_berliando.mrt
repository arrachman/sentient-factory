<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-berliando</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="4">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="25">
          <value>sieid,System.Int64</value>
          <value>sienotransaksi,System.String</value>
          <value>sietgl,System.DateTime</value>
          <value>sieuraian,System.String</value>
          <value>siecatatan,System.String</value>
          <value>supplierkode,System.String</value>
          <value>supppliernama,System.String</value>
          <value>alamat,System.String</value>
          <value>alamat2,System.String</value>
          <value>sumber,System.String</value>
          <value>idtransaksi,System.Int64</value>
          <value>notransaksi,System.String</value>
          <value>tgl,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.String</value>
          <value>totaltransaksi,System.Double</value>
          <value>terbilang,System.String</value>
          <value>sietotaltransaksi,System.Double</value>
          <value>sieterbilang,System.String</value>
          <value>termin,System.String</value>
          <value>uraian,System.String</value>
          <value>harijatuhtempo,System.Int64</value>
          <value>tgljatuhtempo,System.String</value>
          <value>catatan,System.String</value>
          <value>urutan,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT


	sie.sieid , 
	sie.sienotransaksi , 
	sie.sietgl , 
	sie.sieuraian , 
	sie.siecatatan , 


	c.kkode as supplierkode,
	c.knama as supppliernama,
	c.k1alamat1 as alamat,
	c.k1alamat2 as alamat2,
	sied.sumber,
	sied.idtransaksi, 

	(CASE sied.sumber WHEN 'SI' THEN si.sinotransaksi WHEN 'SR' THEN sr.srnotransaksi ELSE '' END) as notransaksi,
(CASE sied.sumber WHEN 'SI' THEN si.sitgl WHEN 'SR' THEN sr.srtgl ELSE '1900-01-01' END) as tgl,
(CASE sied.sumber WHEN 'SI' THEN si.simatauang WHEN 'SR' THEN sr.srmatauang ELSE '' END) as matauang,
(CASE sied.sumber WHEN 'SI' THEN si.sikurs WHEN 'SR' THEN sr.srkurs ELSE '' END) as kurs,

((CASE sied.sumber WHEN 'SI' THEN si.sitotaltransaksi * 1 WHEN 'SR' THEN sr.srtotaltransaksi * -1 ELSE 0 END)* 1)  as totaltransaksi,
(CASE sied.sumber WHEN 'SI' THEN f_nominal(si.sitotaltransaksi, si.simatauang) WHEN 'SR' THEN f_nominal(sr.srtotaltransaksi * -1, sr.srmatauang) ELSE '0' END) as terbilang, 

((CASE sied.sumber WHEN 'SI' THEN SUM(si.sitotaltransaksi) * 1 WHEN 'SR' THEN SUM(sr.srtotaltransaksi) * -1 ELSE 0 END)* 1)  as sietotaltransaksi,
(CASE sied.sumber WHEN 'SI' THEN f_nominal(SUM(si.sitotaltransaksi), si.simatauang) WHEN 'SR' THEN f_nominal(SUM(sr.srtotaltransaksi) * -1, sr.srmatauang) ELSE '0' END) as sieterbilang, 

(CASE sied.sumber WHEN 'v' THEN si.sitermin WHEN 'SR' THEN sr.srtermin ELSE '' END) as termin,
(CASE sied.sumber WHEN 'v' THEN si.siuraian WHEN 'SR' THEN sr.sruraian ELSE '' END) as uraian,
IFNULL(tr.trharijatuhtempo,0) as harijatuhtempo,
(CASE sied.sumber WHEN 'SI' THEN si.sitgljatuhtempo WHEN 'SR' THEN sr.srtgljatuhtempo ELSE '1900-01-01' END) as tgljatuhtempo,
catatan,
urutan

FROM
m5_sie sie
JOIN m5_sie_detail sied ON sie.sieid = sied.idsie
JOIN m0_status st ON sie.siestatus = st.kode
LEFT JOIN m5_si si ON sied.sumber = si.sisumber AND sied.idtransaksi = si.siid
LEFT JOIN m5_sr sr ON sied.sumber = sr.srsumber AND sied.idtransaksi = sr.srid

LEFT JOIN m1_contact c ON IFNULL(si.sicustomer,sr.srcustomer) = c.kid
LEFT JOIN m1_terms tr ON IFNULL(si.sitermin,sr.srtermin) = tr.trkode
LEFT JOIN m1_contact k ON sie.siekontak = k.kid 

WHERE
sie.sienotransaksi = "5171SIE18050036"

GROUP BY sie.sietgl , sieid, sie.sienotransaksi

ORDER BY
sie.sietgl , sieid, sie.sienotransaksi, sied.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
    </DataSources>
