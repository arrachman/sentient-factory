      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="6">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="40">
          <value>sqid,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>idbarangdetail,System.Int64</value>
          <value>dotgl,System.DateTime</value>
          <value>sitotaltransaksi,System.Double</value>
          <value>sihargatermasukpajak,System.Int16</value>
          <value>caption,System.String</value>
          <value>sicustomtext1,System.String</value>
          <value>siid,System.Int64</value>
          <value>sitgl,System.DateTime</value>
          <value>sinotransaksi,System.String</value>
          <value>sicustomer,System.String</value>
          <value>sibagianpenjualan,System.String</value>
          <value>si1alamat1,System.String</value>
          <value>siuraian,System.String</value>
          <value>simatauang,System.String</value>
          <value>sikurs,System.Double</value>
          <value>sidiskonpersen,System.String</value>
          <value>sijmldiskon,System.Double</value>
          <value>sibiayalain,System.Double</value>
          <value>sitotalpajak1detail,System.Double</value>
          <value>sijmluangmuka,System.Double</value>
          <value>sitermin,System.String</value>
          <value>sicustomdbl2,System.Double</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>diskon,System.String</value>
          <value>total,System.Double</value>
          <value>sicustomerkontak,System.String</value>
          <value>sicatatan,System.String</value>
          <value>unama,System.String</value>
          <value>sitglkirim,System.DateTime</value>
          <value>sitgljatuhtempo,System.DateTime</value>
          <value>matauang,System.String</value>
          <value>sonoref,System.String</value>
          <value>jmldiskon,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sq.sqid , 
	sqo.idbarang, sqo.idbarangdetail, 

	doo.dotgl , 
	si.sitotaltransaksi , 

	si.sihargatermasukpajak , 
	CASE si.sihargatermasukpajak
	WHEN 0 THEN "Belum Termasuk Pajak"
	WHEN 1 THEN "Sudah Termasuk Pajak"
END AS "caption" , 

si.sicustomtext1 , 
	si.siid , 
	si.sitgl , 
	si.sinotransaksi , 
	kc.knama AS sicustomer , 
	ks.knama AS sibagianpenjualan  , 
	si.si1alamat1 , 
	
	si.siuraian ,
	si.simatauang , 
	si.sikurs , 
	si.sidiskonpersen , si.sijmldiskon, 
	si.sibiayalain , 
	si.sitotalpajak1detail, 

	si.sijmluangmuka , 
	si.sitermin , 
	si.sicustomdbl2,
	b.bkode , 
	sid.namabarang , 
	sid.catatan , 
	sid.jml , 
	sid.satuan , 
	sid.harga , 
	sid.diskon , 
	((sid.jml * sid.harga)) AS total,
sid.jmldiskon,
	si.sicustomerkontak,
si.sicatatan , 
userr.unama  , 
si.sitglkirim ,
si.sitgljatuhtempo ,  
sid.matauang, 
so.sonoref 

FROM m5_si si
JOIN m1_contact kc ON si.sicustomer = kc.kid
JOIN m1_contact ks ON si.sibagianpenjualan = ks.kid

JOIN m5_si_detail sid ON si.siid = sid.idsi
JOIN m1_item b on sid.idbarang = b.bid

LEFT JOIN m0_user userr on si.siinputuser = userr.userid 

LEFT JOIN m5_do_detail dod ON sid.iddodetail = dod.iddodetail 
LEFT JOIN m5_do doo ON dod.iddo = doo.doid 

LEFT JOIN m5_so_detail sod ON sid.idsodetail = sod.idsodetail 
LEFT JOIN m5_so so ON sod.idso = so.soid 

LEFT JOIN m5_sq_detail sqd ON dod.idsqdetail = sqd.idsqdetail
LEFT JOIN m5_sq sq ON sqd.idsq = sq.sqid
LEFT JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail AND sqo.standar = 0

ORDER BY si.sitgl , si.siid, si.sinotransaksi , sid.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="11">
          <value>sqid,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>idbarangdetail,System.Int64</value>
          <value>sinotransaksi,System.String</value>
          <value>siid,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>hargajual,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sq.sqid , 
	sqo.idbarang, sqo.idbarangdetail, 

	si.sinotransaksi , 
	si.siid , 

	bb.bkode , 
	bb.bnama , 
	sqo.jml , 
	sqo.satuan  , 
	sqo.hargajual , 
	(sqo.jml * sqo.hargajual) AS total

	FROM m5_si si
JOIN m1_contact kc ON si.sicustomer = kc.kid
JOIN m1_contact ks ON si.sibagianpenjualan = ks.kid

JOIN m5_si_detail sid ON si.siid = sid.idsi
JOIN m1_item b on sid.idbarang = b.bid

LEFT JOIN m0_user userr on si.siinputuser = userr.userid 

LEFT JOIN m5_do_detail dod ON sid.iddodetail = dod.iddodetail 
LEFT JOIN m5_do doo ON dod.iddo = doo.doid 

LEFT JOIN m5_so_detail sod ON sid.idsodetail = sod.idsodetail 
LEFT JOIN m5_so so ON sod.idso = so.soid 

LEFT JOIN m5_sq_detail sqd ON dod.idsqdetail = sqd.idsqdetail
LEFT JOIN m5_sq sq ON sqd.idsq = sq.sqid
LEFT JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail AND sqo.standar = 0
LEFT JOIN m1_item bb ON sqo.idbarang = bb.bid 

ORDER BY si.sitgl , si.siid, si.sinotransaksi , sid.urutan</SqlCommand>
      </DS2>
