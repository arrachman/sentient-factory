<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-berliando</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>sinotransaksi,System.String</value>
          <value>sicustomerkode,System.String</value>
          <value>sicustomernama,System.String</value>
          <value>idbarang,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>serialbatchkode,System.String</value>
          <value>serialbatchjml,System.String</value>
          <value>serialbatchsatuan,System.String</value>
          <value>serialbatchtglexpired,System.String</value>
          <value>bavolume,System.String</value>
          <value>supplierkode,System.String</value>
          <value>suppliernama,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	si.sinotransaksi,
	c.kkode AS sicustomerkode,
	c.knama AS sicustomernama,
	sid.idbarang,
	i.bkode,
	i.bnama,

	CASE 
	WHEN i.bbatch = 1 AND i.bserial = 0 THEN nbt.nbtkode
	WHEN i.bbatch = 0 AND i.bserial = 1 THEN nst.nstkode
	WHEN i.bbatch = 0 AND i.bserial = 0 THEN ""
END AS "serialbatchkode" , 
CASE 
	WHEN i.bbatch = 1 AND i.bserial = 0 THEN nbt.nbtjml
	WHEN i.bbatch = 0 AND i.bserial = 1 THEN nst.nstjml
	WHEN i.bbatch = 0 AND i.bserial = 0 THEN ""
END AS "serialbatchjml" ,
CASE 
	WHEN i.bbatch = 1 AND i.bserial = 0 THEN nbt.nbtsatuan
	WHEN i.bbatch = 0 AND i.bserial = 1 THEN nst.nstsatuan
	WHEN i.bbatch = 0 AND i.bserial = 0 THEN ""
END AS "serialbatchsatuan" , 
CASE 
	WHEN i.bbatch = 1 AND i.bserial = 0 THEN nbt.nbtcustomdate1
	WHEN i.bbatch = 0 AND i.bserial = 1 THEN " - "
	WHEN i.bbatch = 0 AND i.bserial = 0 THEN ""
END AS "serialbatchtglexpired" , 

i.bavolume,
c2.kkode AS supplierkode,
c2.knama AS suppliernama

FROM m5_si_detail sid
JOIN m5_si si ON sid.idsi = si.siid
JOIN m1_item i ON sid.idbarang = i.bid
LEFT JOIN m1_no_batch_transaction nbt ON sid.idbarang = nbt.nbtidbarang AND sid.idsi = nbt.nbtidtransaksi AND nbt.nbtsumber = "SI"
LEFT JOIN m1_no_serial_transaction nst ON sid.idbarang = nst.nstidbarang AND sid.idsi = nst.nstidtransaksi AND nst.nstsumber = "SI"
LEFT JOIN m1_contact c ON si.sicustomer = c.kid
LEFT JOIN m1_item_supplier isp ON i.bid = isp.isidbarang
LEFT JOIN m1_contact c2 ON isp.isidkontak = c2.kid

WHERE (si.sistatus  = 2 OR si.sistatus = 3 OR si.sistatus = 4 OR si.sistatus  = 7 )
AND si.sinotransaksi IN (
"5171SI18113427",
"5171SI18113340"
)

GROUP BY nbt.nbtid, nst.nstid

ORDER BY sid.urutan</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
