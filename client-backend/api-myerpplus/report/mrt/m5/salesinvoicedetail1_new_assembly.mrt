          <value>catatan,System.String</value>
          <value>jmlserial,System.Double</value>
          <value>satuan,System.String</value>
          <value>harga,System.Double</value>
          <value>diskon,System.String</value>
          <value>total,System.Double</value>
          <value>idbarangassembly,System.Int64</value>
          <value>iaidbarangpenyusun,System.Int64</value>
          <value>kodebarangassembly,System.String</value>
          <value>namabarangassembly,System.String</value>
          <value>jmlbarangassembly,System.Double</value>
          <value>jmlassembly,System.Double</value>
          <value>satuanbarangassembly,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	si.siid , 
	si.sitgl , 
	si.sinotransaksi , 
	kc.knama AS sicustomer , 
	ks.knama AS sibagianpenjualan  , 
	st.nama AS sistatus ,
	si.siuraian ,
	si.simatauang , 
	si.sikurs , 
	si.sidiskonpersen , si.sijmldiskon, 
	si.sibiayalain , 
	si.sitotalpajak1detail, 

	b.bkode , 
	sid.namabarang , 
	sid.catatan , 
	sid.jml AS jmlserial, 
	sid.satuan , 
	sid.harga , 
	sid.diskon, 
	((sid.jml * sid.harga) - sid.jmldiskon) AS total ,

	ia.iaidbarang AS idbarangassembly,
	ia.iaidbarangpenyusun , 
	b1.bkode AS kodebarangassembly, 
	b1.bnama AS namabarangassembly, 
	ia.iajml AS jmlbarangassembly, 
	sid.jmlbarang * ia.iajml AS jmlassembly ,
	ia.iasatuan AS satuanbarangassembly

	FROM m5_si si
JOIN m1_contact kc ON si.sicustomer = kc.kid
JOIN m1_contact ks ON si.sibagianpenjualan = ks.kid
JOIN m0_status st on si.sistatus = st.kode

JOIN m5_si_detail sid ON si.siid = sid.idsi
JOIN m1_item b on sid.idbarang = b.bid

JOIN m1_item_assembly ia ON ia.iaidbarang = sid.idbarang
JOIN m1_item b1 ON b1.bid = ia.iaidbarangpenyusun

ORDER BY si.sitgl , si.siid, si.sinotransaksi , sid.idbarang,  sid.urutan, ia.iaurutan</SqlCommand>
      </DS2>
