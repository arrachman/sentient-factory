    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="38">
          <value>sqcatatan,System.String</value>
          <value>sqcustomerkontak,System.String</value>
          <value>sqtotaltransaksi,System.Double</value>
          <value>terbilang,System.String</value>
          <value>sqid,System.Int64</value>
          <value>sqnotransaksi,System.String</value>
          <value>sqtgl,System.DateTime</value>
          <value>sqcustomer,System.String</value>
          <value>k1alamat1,System.String</value>
          <value>k1notelp1,System.String</value>
          <value>k1nofax,System.String</value>
          <value>k1email,System.String</value>
          <value>sqbagianpenjualan,System.String</value>
          <value>alamatpenj,System.String</value>
          <value>notlppenj,System.String</value>
          <value>nofaxpenj,System.String</value>
          <value>attnto,System.String</value>
          <value>emailpenj,System.String</value>
          <value>sqstatus,System.String</value>
          <value>squraian,System.String</value>
          <value>sqmatauang,System.String</value>
          <value>sqkurs,System.Double</value>
          <value>sqdiskonpersen,System.String</value>
          <value>sqjmldiskon,System.Double</value>
          <value>sqbiayalain,System.Double</value>
          <value>sqtotalpajak1detail,System.Double</value>
          <value>jmldiskon,System.Double</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>sqtglkirim,System.DateTime</value>
          <value>sqcustomtext3,System.String</value>
          <value>urutan,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	sq.sqcatatan,
	sq.sqcustomerkontak,
	sq.sqtotaltransaksi, 
	f_nominal(sq.sqtotaltransaksi, sq.sqmatauang) AS terbilang, 
	sq.sqid , 
	sq.sqnotransaksi , 
	sq.sqtgl, 
	kc.knama AS sqcustomer, 
	kc.k1alamat1 , 
	kc.k1notelp1 , 
	kc.k1nofax , 
	kc.k1email , 

	ks.knama AS sqbagianpenjualan , 
	ks.k1alamat1 AS alamatpenj, 
	ks.k1notelp1 notlppenj, 
ks.k1nofax AS nofaxpenj , 
sq.sq2alamat2 as attnto,
sq.sq2alamat3  emailpenj, 
	st.nama AS sqstatus , 
	sq.squraian , 
	sq.sqmatauang , 
	sq.sqkurs , 
	sq.sqdiskonpersen , sq.sqjmldiskon , 
	sq.sqbiayalain , 
	(sq.sqtotalpajak1detail + sq.sqtotalpajak2detail) AS sqtotalpajak1detail, 
sqd.jmldiskon,
	b.bkode , sqd.namabarang , sqd.catatan , 
	sqd.jml , 
	sqd.satuan , 
	sqd.diskon , 
	sqd.harga , 
	((sqd.jml * sqd.harga) ) AS total , 
sq.sqtglkirim , 
sq.sqcustomtext3 , 
sqd.urutan 

FROM m5_sq sq 
JOIN m1_contact kc ON sq.sqcustomer = kc.kid
JOIN m1_contact ks ON sq.sqbagianpenjualan = ks.kid
JOIN m0_status st ON sq.sqstatus = st.kode

JOIN m5_sq_detail sqd ON sq.sqid = sqd.idsq
JOIN m1_item b ON sqd.idbarang = b.bid

WHERE sq.sqnotransaksi = "KISQ17110001" 

ORDER BY sq.sqtgl , sq.sqid , sq.sqnotransaksi , sqd.urutan </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
