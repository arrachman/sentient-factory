	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="21">
          <value>kjumlah,System.Int32</value>
          <value>pvid,System.Int64</value>
          <value>pvtgl,System.DateTime</value>
          <value>pvnotransaksi,System.String</value>
          <value>pvcustomer,System.String</value>
          <value>pvuraian,System.String</value>
          <value>pvmatauang,System.String</value>
          <value>pvkurs,System.Double</value>
          <value>pvstatus,System.String</value>
          <value>notransaksi,System.String</value>
          <value>tanggal,System.DateTime</value>
          <value>sumber,System.String</value>
          <value>matauang,System.String</value>
          <value>kurs,System.Double</value>
          <value>nogiro,System.String</value>
          <value>totaltransaksi,System.Double</value>
          <value>terbayar,System.Double</value>
          <value>jmlbayar,System.Double</value>
          <value>jmlbayarvalas,System.Double</value>
          <value>termin,System.String</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	CASE pvd.sumber 
	WHEN "IP" THEN 1 
	WHEN "AS" THEN 1
	WHEN "CA" THEN 1
ELSE 0 
END AS kjumlah , 

	pv.pvid, 
	pv.pvtgl , 
	pv.pvnotransaksi , 
	kc.knama AS pvcustomer, 
	pv.pvuraian , 
	pv.pvmatauang , 
	pv.pvkurs , 
	st.nama AS pvstatus,

	CASE sumber
	WHEN "SI" then si.sinotransaksi 
	WHEN "RP" then rp.rpnotransaksi 
	WHEN "IP" then ip.ipnotransaksi 
	WHEN "AS" then ass.asnotransaksi 
	WHEN "SR" then sr.srnotransaksi 
	WHEN "CA" then CONCAT(pvd.sumber,"(",coa.cnomor, ")")
END as notransaksi ,
CASE sumber
	WHEN "SI" then si.sitgl 
	WHEN "RP" then rp.rptgl
	WHEN "IP" then ip.iptgl
	WHEN "AS" then ass.astgl
	WHEN "SR" then sr.srtgl
	END as tanggal, 
pvd.sumber , 
pvd.matauang , 
pvd.kurs , 
pvd.nogiro ,
/*AR = SI , RP , CA
AP =  IP , AS, SR, */
pvd.totaltransaksi , 
pvd.terbayar , 
CASE sumber
	WHEN "SI" then pvd.jmlbayar
	WHEN "RP" then pvd.jmlbayar
	WHEN "IP" then (pvd.jmlbayar * -1)
	WHEN "AS" then (pvd.jmlbayar * -1)
	WHEN "SR" then (pvd.jmlbayar * -1)
	WHEN "CA" then pvd.jmlbayar
END as jmlbayar ,
CASE sumber
	WHEN "SI" then pvd.jmlbayarvalas
	WHEN "RP" then pvd.jmlbayarvalas
	WHEN "IP" then (pvd.jmlbayarvalas * -1)
	WHEN "AS" then (pvd.jmlbayarvalas * -1)
	WHEN "SR" then (pvd.jmlbayarvalas * -1)
	WHEN "CA" then pvd.jmlbayarvalas
END as jmlbayarvalas,  
CASE sumber
	WHEN "SI" then si.sitermin 
	WHEN "RP" then rp.rptermin
	WHEN "IP" then ip.iptermin
	WHEN "AS" then ass.astermin
	WHEN "SR" then sr.srtermin
	END as termin, 
CASE sumber
	WHEN "SI" then si.sicatatan
	WHEN "RP" then rp.rpcatatan
	WHEN "IP" then ip.ipcatatan
	WHEN "AS" then ass.ascatatan
	WHEN "SR" then sr.srcatatan
	END as catatan 

FROM
m5_pv pv
JOIN m1_contact kc ON pv.pvcustomer = kc.kid
JOIN m0_status st ON pv.pvstatus = st.kode

JOIN m5_pv_detail pvd ON pv.pvid = pvd.idpv
LEFT JOIN m5_si si ON pvd.sumber = si.sisumber AND pvd.idtransaksi = si.siid
LEFT JOIN m5_rp rp ON pvd.sumber = rp.rpsumber AND pvd.idtransaksi = rp.rpid
LEFT JOIN m5_ip ip ON pvd.sumber = ip.ipsumber AND pvd.idtransaksi = ip.ipid
LEFT JOIN m5_as ass ON pvd.sumber = ass.assumber AND pvd.idtransaksi = ass.asid
LEFT JOIN m5_sr sr ON pvd.sumber = sr.srsumber AND pvd.idtransaksi = sr.srid
LEFT JOIN m1_coa coa ON pvd.rekhutangpiutang = coa.cnomor

ORDER BY
pv.pvtgl, pv.pvid , pv.pvnotransaksi , pvd.sumber = "SI" DESC , pvd.sumber = "RP" DESC , pvd.sumber = "IP" DESC , pvd.sumber = "AS" DESC , pvd.sumber = "SR" DESC, pvd.sumber = "CA" DESC  , pvd.urutan</SqlCommand>
      </DS2>
      <DS3 Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="14">
          <value>pvid,System.Int64</value>
          <value>pvtgl,System.DateTime</value>
          <value>pvnotransaksi,System.String</value>
          <value>id,System.Int64</value>
          <value>carabayar,System.String</value>
          <value>cnomor,System.String</value>
          <value>cnama,System.String</value>
          <value>jumlah,System.Double</value>
          <value>jumlahvalas,System.Double</value>
          <value>bank,System.String</value>
          <value>nogiro,System.String</value>
          <value>tgljt,System.DateTime</value>
          <value>noacbank,System.String</value>
          <value>cara,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	pv.pvid, 
	pv.pvtgl , 
	pv.pvnotransaksi , 

	CASE sumber
	WHEN "RP" then rp.idrp
	WHEN "IP" then ip.idip
	WHEN "AS" then ass.idas
		END as id ,

	CASE sumber
	WHEN "RP" then CASE rp.carabayar 
									WHEN 0	THEN "Cash"
									WHEN 1	THEN "Transfer"
									WHEN 2	THEN "Check/Giro"
									WHEN 3	THEN "Other"
									WHEN 4	THEN "Credit Card"
									WHEN 5	THEN "Debit Card"
									WHEN 6	THEN "Voucher"
									WHEN 7	THEN "Point"
									WHEN 8	THEN "Member Card (Kupon)"
									WHEN 9	THEN "Member Card (SHU)"
								END
	WHEN "IP" then CASE ip.carabayar
									WHEN 0	THEN "Cash"
									WHEN 1	THEN "Transfer"
									WHEN 2	THEN "Check/Giro"
									WHEN 3	THEN "Other"
									WHEN 4	THEN "Credit Card"
									WHEN 5	THEN "Debit Card"
									WHEN 6	THEN "Voucher"
									WHEN 7	THEN "Point"
									WHEN 8	THEN "Member Card (Kupon)"
									WHEN 9	THEN "Member Card (SHU)"
								END
	WHEN "AS" then CASE ass.carabayar 
									WHEN 0	THEN "Cash"
									WHEN 1	THEN "Transfer"
									WHEN 2	THEN "Check/Giro"
									WHEN 3	THEN "Other"
									WHEN 4	THEN "Credit Card"
									WHEN 5	THEN "Debit Card"
									WHEN 6	THEN "Voucher"
									WHEN 7	THEN "Point"
									WHEN 8	THEN "Member Card (Kupon)"
									WHEN 9	THEN "Member Card (SHU)"
								END
		END as carabayar , 

	CASE sumber
	WHEN "RP" then coa1.cnomor
	WHEN "IP" then coa2.cnomor
	WHEN "AS" then coa3.cnomor
		END as cnomor , 
CASE sumber
	WHEN "RP" then coa1.cnama
	WHEN "IP" then coa2.cnama
	WHEN "AS" then coa3.cnama
		END as cnama , 

	CASE sumber
	WHEN "RP" then rp.jumlah
	WHEN "IP" then ip.jumlah
	WHEN "AS" then ass.jumlah
		END as jumlah , 

	CASE sumber
	WHEN "RP" then rp.jumlahvalas
	WHEN "IP" then ip.jumlahvalas
	WHEN "AS" then ass.jumlahvalas
END as jumlahvalas , 

	CASE sumber
	WHEN "RP" then rp.bank
	WHEN "IP" then ip.bank
	WHEN "AS" then ass.bank
		END as bank , 

	CASE sumber
	WHEN "RP" then rp.nogiro
	WHEN "IP" then ip.nogiro
	WHEN "AS" then ass.nogiro
		END as nogiro ,

CASE sumber
	WHEN "RP" then rp.tgljt
	WHEN "IP" then ip.tgljt
	WHEN "AS" then ass.tgljt
		END as tgljt , 

CASE sumber
	WHEN "RP" then rp.noacbank
	WHEN "IP" then ip.noacbank
	WHEN "AS" then ass.noacbank
		END as noacbank , 


	CASE sumber
	WHEN "RP" then rp.carabayar 
	WHEN "IP" then ip.carabayar
	WHEN "AS" then ass.carabayar 
END as cara 


FROM m5_pv pv
JOIN m5_pv_detail pvd ON pv.pvid = pvd.idpv
LEFT JOIN m5_rp_pay rp ON pvd.sumber = "RP" AND pvd.idtransaksi = rp.idrp
LEFT JOIN m5_ip_pay ip ON pvd.sumber = "IP" AND pvd.idtransaksi = ip.idip
LEFT JOIN m5_as_pay ass ON pvd.sumber = "AS" AND pvd.idtransaksi = ass.idas

LEFT JOIN m1_coa coa1 ON rp.rekbank = coa1.cnomor AND pvd.sumber = "RP"
LEFT JOIN m1_coa coa2 ON ip.rekbank = coa1.cnomor AND pvd.sumber = "IP"
LEFT JOIN m1_coa coa3 ON rp.rekbank = coa1.cnomor AND pvd.sumber = "RP"



ORDER BY pv.pvtgl, pv.pvid , pv.pvnotransaksi , pvd.sumber = "SI" DESC , pvd.sumber = "RP" DESC , pvd.sumber = "IP" DESC , pvd.sumber = "AS" DESC , pvd.sumber = "SR" DESC, pvd.sumber = "CA" DESC  , pvd.urutan</SqlCommand>
      </DS3>
