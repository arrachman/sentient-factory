	FROM
	m5_so so
JOIN m5_so_detail sod ON so.soid = sod.idso
JOIN m5_sq_detail sqd ON sod.idsqdetail = sqd.idsqdetail
JOIN m5_sq sq ON sqd.idsq = sq.sqid
JOIN m5_sq_out_bahan sqo ON sq.sqid = sqo.idsq 
AND sqo.standar = 0
AND sqo.jml &lt;= 0 

JOIN m1_item bb ON sqo.idbarang = bb.bid 

GROUP BY sqo.idsqout
ORDER BY so.soid ASC , sod.urutan ASC, sqo.urutan </SqlCommand>
      </DS3>
      <DS4 Ref="10" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
