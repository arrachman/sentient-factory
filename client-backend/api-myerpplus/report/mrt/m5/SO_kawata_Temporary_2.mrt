    <DataSources isList="true" count="8">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="41">
          <value>standar,System.Int16</value>
          <value>ETD,System.String</value>
          <value>ETA,System.String</value>
          <value>ETDDate,System.DateTime</value>
          <value>ETADate,System.DateTime</value>
          <value>sototaltransaksi,System.Double</value>
          <value>alamatsales,System.String</value>
          <value>sotglkirim,System.DateTime</value>
          <value>sotermin,System.String</value>
          <value>terbilang,System.String</value>
          <value>sohargatermasukpajak,System.Int16</value>
          <value>caption,System.String</value>
          <value>soid,System.Int64</value>
          <value>sonotransaksi,System.String</value>
          <value>sotgl,System.DateTime</value>
          <value>socustomer,System.String</value>
          <value>k1alamat1,System.String</value>
          <value>sobagianpenjualan,System.String</value>
          <value>sostatus,System.String</value>
          <value>somatauang,System.String</value>
          <value>sokurs,System.Double</value>
          <value>souraian,System.String</value>
          <value>sodiskonpersen,System.String</value>
          <value>sojmldiskon,System.Double</value>
          <value>sobiayalain,System.Double</value>
          <value>sototalpajak1detail,System.Double</value>
          <value>bkode,System.String</value>
          <value>namabarang,System.String</value>
          <value>sqnotransaksi,System.String</value>
          <value>catatan,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>diskon,System.String</value>
          <value>harga,System.Double</value>
          <value>total,System.Double</value>
          <value>unama,System.String</value>
          <value>sqid,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>sqojml,System.Double</value>
          <value>ksalesmannama,System.String</value>
          <value>sonoref,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sqo.standar , 

	so.socustomtext1 AS ETD , 
	so.socustomtext2 AS ETA , 
	so.socustomdate2 AS ETDDate ,
	so.socustomdate3 AS ETADate ,

	so.sototaltransaksi , 
	ks.k1alamat1 AS alamatsales , 
	so.sotglkirim , 
	so.sotermin , 
	f_nominal(so.sototaltransaksi, so.somatauang) as terbilang, 

	so.sohargatermasukpajak , 
	CASE so.sohargatermasukpajak
	WHEN 0 THEN "Belum Termasuk Pajak"
	WHEN 1 THEN "Sudah Termasuk Pajak"
END AS "caption" , 

	so.soid, 
	so.sonotransaksi , 
	so.sotgl , 
	kc.knama AS socustomer , 
	kc.k1alamat1 , 
	ks.knama AS sobagianpenjualan , 
	st.nama AS sostatus , 
	so.somatauang , 
	so.sokurs , 
	so.souraian , 
	so.sodiskonpersen , 
	so.sojmldiskon , 
	so.sobiayalain , 
	so.sototalpajak1detail , 

	b.bkode , 
	sod.namabarang , 
	sq.sqnotransaksi , 
	sod.catatan, 
	sod.jml, 
	sod.satuan , 
	sod.diskon, 
	sod.harga , 
	((sod.jml * sod.harga) - sod.jmldiskon) AS total , 
usr.unama , 
	sq.sqid,
	sod.idbarang , 
IFNULL(SUM(sqo.jml * sqo.hargajual),0) AS sqojml , 
kc.ksalesmannama 

FROM m5_so so 
JOIN m1_contact kc ON so.socustomer = kc.kid 
JOIN m1_contact ks ON so.sobagianpenjualan = ks.kid
JOIN m0_status st ON so.sostatus = st.kode

JOIN m5_so_detail sod on so.soid = sod.idso 
JOIN m1_item b ON sod.idbarang = b.bid 
LEFT JOIN m5_sq_detail sqd ON sod.idsqdetail = sqd.idsqdetail
LEFT JOIN m5_sq sq ON sqd.idsq = sq.sqid 
LEFT JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail AND sqo.standar = 0

JOIN m0_user usr ON so.soinputuser = usr.userid

GROUP BY so.sotgl, so.soid , so.sonotransaksi , sq.sqid , sqd.idsqdetail
ORDER BY  so.sotgl , so.soid , so.sonotransaksi , sod.urutan </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="10">
          <value>sqid,System.Int64</value>
          <value>idbarangdetail,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>hargajual,System.Double</value>
          <value>total,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	sq.sqid,
	sqo.idbarangdetail , 
	sqo.idbarang ,

	bb.bkode , 
	bb.bnama , 
	sqo.jml , 
	sqo.satuan  , 
	sqo.hargajual , 
	(sqo.jml * sqo.hargajual) AS total ,
	sqd.catatan


	FROM
	m5_so so
JOIN m5_so_detail sod ON so.soid = sod.idso
JOIN m5_sq_detail sqd ON sod.idsqdetail = sqd.idsqdetail
JOIN m5_sq sq ON sqd.idsq = sq.sqid
JOIN m5_sq_out_bahan sqo ON sq.sqid = sqo.idsq 
AND sqo.standar = 0
AND sqo.jml &gt; 0 

JOIN m1_item bb ON sqo.idbarang = bb.bid 

GROUP BY sqo.idsqout
ORDER BY so.soid ASC , sod.urutan ASC, sqo.urutan </SqlCommand>
      </DS2>
