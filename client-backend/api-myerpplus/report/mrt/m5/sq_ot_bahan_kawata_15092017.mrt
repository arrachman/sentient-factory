	sqo.satuan , 
	sqo.hargajual , 
	sqd.catatan

	FROM m5_sq_detail sqd
JOIN m5_sq sq on sqd.idsq = sq.sqid
JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail 
AND sqo.standar = 0 
AND sqo.jml &gt; 0 
JOIN m1_item b ON sqo.idbarang = b.bid 
AND b.bpromo = 1

ORDER BY sqd.idsq , sqd.idsqdetail , sqd.idbarang , sqo.urutan</SqlCommand>
