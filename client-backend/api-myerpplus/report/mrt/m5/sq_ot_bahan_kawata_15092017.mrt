      </formatNominal>
      <DS2 Ref="8" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS2</Alias>
        <Columns isList="true" count="10">
          <value>idsqdetail,System.Int64</value>
          <value>idbarangdetail,System.Int64</value>
          <value>idsq,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>btipe,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>hargajual,System.Double</value>
          <value>total,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS2</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sqd.idsqdetail , 
	sqo.idbarangdetail , 
	sqd.idsq , 
	b.bkode , 
	b.bnama , 
	b.btipe , 

	SUM(sqo.jml) AS jml , 
	sqo.satuan , 
	sqo.hargajual , 
	SUM(sqo.jml * sqo.hargajual) AS total 

	FROM m5_sq_detail sqd
JOIN m5_sq sq on sqd.idsq = sq.sqid
JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail 
JOIN m1_item b ON sqo.idbarang = b.bid 

WHERE sqo.standar = 1 

GROUP BY sqd.idsq , sqd.idsqdetail , sqd.idbarang 
ORDER BY sqd.idsq , sqd.idsqdetail , sqd.idbarang </SqlCommand>
      </DS2>
      <DS3 Ref="9" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS3</Alias>
        <Columns isList="true" count="11">
          <value>idsqdetail,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>idbarangdetail,System.Int64</value>
          <value>idsq,System.Int64</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>btipe,System.String</value>
          <value>jml,System.Double</value>
          <value>satuan,System.String</value>
          <value>hargajual,System.Double</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS3</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sqd.idsqdetail , 
	sqd.idbarang , sqo.idbarangdetail  , 
	sqd.idsq , 
	b.bkode , 
	sqo.namabarang as bnama , 
	b.btipe , 

	(sqo.jml) AS jml , 
	sqo.satuan , 
	sqo.hargajual , 
	sqd.catatan

	FROM m5_sq_detail sqd
JOIN m5_sq sq on sqd.idsq = sq.sqid
JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail 
AND sqo.standar = 0 
AND sqo.jml &gt; 0 
JOIN m1_item b ON sqo.idbarang = b.bid 
AND b.bpromo = 0 

ORDER BY sqd.idsq , sqd.idsqdetail , sqd.idbarang , sqo.urutan</SqlCommand>
      </DS3>
