	sqo.hargajual , 
	sqd.catatan

	FROM m5_sq_detail sqd
JOIN m5_sq sq on sqd.idsq = sq.sqid
JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq AND sqd.idbarang = sqo.idbarangdetail 
AND sqo.standar = 0 
AND sqo.jml &lt;= 0 
JOIN m1_item b ON sqo.idbarang = b.bid 

ORDER BY sqd.idsq , sqd.idsqdetail , sqd.idbarang </SqlCommand>
      </DS4>
      <DS5 Ref="11" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS5</Alias>
        <Columns isList="true" count="4">
          <value>idsqdetail,System.Int64</value>
          <value>idbarang,System.Int64</value>
          <value>idsq,System.Int64</value>
          <value>catatan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS5</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	sqd.idsqdetail , 
	sqd.idbarang , 
	sqd.idsq ,  
	sqd.catatan

	FROM m5_sq_detail sqd
JOIN m5_sq sq on sqd.idsq = sq.sqid

WHERE sqd.catatan &lt;&gt; ""


ORDER BY sqd.idsq , sqd.idsqdetail , sqd.idbarang , sqd.urutan </SqlCommand>
      </DS5>
