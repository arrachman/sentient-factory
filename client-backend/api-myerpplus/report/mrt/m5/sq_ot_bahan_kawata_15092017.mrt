        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS6</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	SQ.SQCUSTOMERKONTAK,
	sq.sqtotaltransaksi, 
	f_nominal(sq.sqtotaltransaksi, sq.sqmatauang) AS terbilang, 
	sq.sqtermin , 
	sq.sqcustomdate1 AS exfactory , 
	sq.sqcustomdate2 AS etd , 
	sq.sqcustomtext4 AS etdcaption , 
	sq.sqcustomdate3 AS eta , 
	sq.sqcustomtext5 AS etacaption , 
	sq.sqcustomtext3 AS delivery , 
	IF(sq.sqcustomtext3,"",0) AS capdelivery ,
	sq.sqcustomtext1 AS validity , 

	sq.sqid , 
	sqd.idsqdetail , 
	sqd.idbarang , 
	sq.sqnotransaksi , 
	sq.sqtgl, 
	kc.knama AS sqcustomer, 
	kc.k1alamat1 , 
	kc.k1notelp1 , 
	kc.k1nofax , 
	kc.k1email , 

	ks.knama AS sqbagianpenjualan , 
	ks.k1alamat1 AS alamatpenj, 
	ks.k1notelp1 notlppenj, 
ks.k1nofax AS nofaxpenj , 
sq.sq2alamat2 as attnto,
sq.sq2alamat3  emailpenj, 
	st.nama AS sqstatus , 
	sq.squraian , 
sq.sqcatatan , 
	sq.sqmatauang , 
	sq.sqkurs , 
	sq.sqdiskonpersen , sq.sqjmldiskon , 
	sq.sqbiayalain , 
	sq.sqtotalpajak1detail, 

	b.bkode , sqd.namabarang , sqd.catatan , 
	sqd.jml , 
	sqd.satuan , 
	sqd.diskon , 
	sqd.harga , 
	((sqd.jml * sqd.harga) - sqd.jmldiskon) AS total , 
b.bcatatan  , 
IFNULL(SUM(sqo.jml * sqo.hargajual),0) AS sqojml 

FROM m5_sq sq 
JOIN m1_contact kc ON sq.sqcustomer = kc.kid
JOIN m1_contact ks ON sq.sqbagianpenjualan = ks.kid
JOIN m0_status st ON sq.sqstatus = st.kode

JOIN m5_sq_detail sqd ON sq.sqid = sqd.idsq
JOIN m1_item b ON sqd.idbarang = b.bid

LEFT JOIN m5_sq_out_bahan sqo ON sqd.idsq = sqo.idsq 
AND sqd.idbarang = sqo.idbarangdetail 
AND sqo.standar = 0

#WHERE sq.sqnotransaksi = "KISQ-17-1655" 
#WHERE sq.sqnotransaksi = "KISQ-17-1662R1"

GROUP BY sq.sqtgl , sq.sqid , sq.sqnotransaksi , sqd.idsqdetail 
ORDER BY sq.sqtgl , sq.sqid , sq.sqnotransaksi , sqd.urutan </SqlCommand>
      </DS6>
