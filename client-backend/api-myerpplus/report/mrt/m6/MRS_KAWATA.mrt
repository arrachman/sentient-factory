<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.02" type="Net" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus_kawata</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="21">
          <value>wodimintaolehkontak,System.String</value>
          <value>woid,System.Int64</value>
          <value>wonotransaksi,System.String</value>
          <value>wotgl,System.DateTime</value>
          <value>wotgldipakai,System.DateTime</value>
          <value>wouraian,System.String</value>
          <value>woidbom,System.Int64</value>
          <value>mrsnotransaksi,System.String</value>
          <value>bnama,System.String</value>
          <value>jml,System.Double</value>
          <value>jmlbarang,System.Double</value>
          <value>satuan,System.String</value>
          <value>wojenis,System.String</value>
          <value>kodebarang,System.String</value>
          <value>namabarang,System.String</value>
          <value>jumlah,System.Double</value>
          <value>sat,System.String</value>
          <value>kodebarangjadi,System.String</value>
          <value>namabarangjadi,System.String</value>
          <value>notransaksimo,System.String</value>
          <value>gudang,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	k.knama AS wodimintaolehkontak ,

	mrs.mrsid AS woid , 
	mrs.mrstgl  AS wotgl , 
	mrs.mrstgldipakai AS wotgldipakai , 

	mrs.mrsuraian AS wouraian , 
	mrs.mrsidbom AS woidbom, 
	mrs.mrsnotransaksi AS mrsnotransaksi , 
   
	mrsin.jml , mrsin.jmlbarang, 
	mrsin.satuan , 
	mrs.mrsjenis AS wojenis , 

	bb.bkode AS kodebarang , 
	bb.bnama AS namabarang , 
	mrsout.jml AS jumlah , 
	mrsout.satuan AS sat,
	wo.wonotransaksi AS wonotransaksi ,
	pdr.pdrnotransaksi AS notransaksimo ,
	bo.bkode as kodebarangjadi,
	bo.bnama AS namabarangjadi,
	w.wnama AS gudang
	FROM m6_mrs mrs 
LEFT JOIN m6_mrs_in mrsin ON mrs.mrsid = mrsin.idmrs
LEFT JOIN m6_bom bom ON mrs.mrsidbom = bom.bomid 
LEFT JOIN m1_item b ON mrsin.idbarang = b.bid 
LEFT JOIN m6_wo wo ON mrs.mrsidwo = wo.woid
LEFT JOIN m6_wo_in woin ON wo.woid = woin.idwo
JOIN m1_item bo ON woin.idbarang = bo.bid 

LEFT JOIN m6_pdr pdr ON mrs.mrsidpdr = pdr.pdrid
LEFT JOIN m1_warehouse w ON mrs.mrsgudangasal = w.wkode


JOIN m6_mrs_out mrsout ON mrs.mrsid = mrsout.idmrs
JOIN m1_item bb ON mrsout.idbarang = bb.bid 

JOIN m1_contact k ON mrs.mrsbagianmrs = k.kid 
ORDER BY mrs.mrstgl ASC , mrs.mrsid ASC , mrs.mrsnotransaksi ASC </SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
