    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="29">
          <value>KIMO,System.String</value>
          <value>KIMOTGL,System.DateTime</value>
          <value>KISO,System.String</value>
          <value>ENDUSER,System.String</value>
          <value>DESCRIPTION,System.String</value>
          <value>KODEMESIN,System.String</value>
          <value>NAMAMESIN,System.String</value>
          <value>JMLMESIN,System.Double</value>
          <value>SATUANMESIN,System.String</value>
          <value>HARGAJUAL,System.Double</value>
          <value>HARGAJUALCURR,System.Double</value>
          <value>CURRENCYSO,System.String</value>
          <value>SUMBER,System.String</value>
          <value>TGL,System.DateTime</value>
          <value>NOTRANSAKSI,System.String</value>
          <value>URAIAN,System.String</value>
          <value>IDBARANG,System.Int64</value>
          <value>KODE,System.String</value>
          <value>NAMA,System.String</value>
          <value>JML,System.Double</value>
          <value>SATUAN,System.String</value>
          <value>HPP,System.Double</value>
          <value>NILAI,System.Double</value>
          <value>HARGA,System.Double</value>
          <value>HARGACURR,System.Double</value>
          <value>MATAUANG,System.String</value>
          <value>HARGAJUALSI,System.Double</value>
          <value>HARGAJUALCURRSI,System.Double</value>
          <value>CURRENCYSI,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	wip.KIMO,
	wip.KIMOTGL,
	IFNULL(so.sonotransaksi,'') as KISO,
	IFNULL(c.knama,'') as ENDUSER,
	wip.DESCRIPTION,
	wip.KODEMESIN,
	wip.NAMAMESIN,
	wip.JMLMESIN,
	wip.SATUANMESIN,
	(IFNULL(sod.harga * cr.ckurs,0)*1) as HARGAJUAL,
	(IFNULL(sod.harga,0)*1) as HARGAJUALCURR,
	IFNULL(sod.matauang,'USD') as CURRENCYSO,
	(IFNULL(sid.harga * cr.ckurs,0)*1) as HARGAJUALSI,
	(IFNULL(sid.harga,0)*1) as HARGAJUALCURRSI,
	IFNULL(sid.matauang,'USD') as CURRENCYSI,
	wip.SUMBER,
	wip.TGL,
	wip.NOTRANSAKSI,
	wip.URAIAN,
	wip.IDBARANG,
	wip.KODE,
	wip.NAMA,
	(SUM(wip.JML)*1) as JML,
	wip.SATUAN,
	(SUM(wip.NILAI)/SUM(wip.JML)*1) as HPP,
	(SUM(wip.NILAI)*1) as NILAI, 
	(IFNULL(lgrn.harga, 0 ) * 1) as HARGA, 
	(IFNULL(lgrn.hargacurr, 0 ) * 1) as HARGACURR, 
	IFNULL(lgrn.matauang, 'USD') as MATAUANG	
	FROM
(
SELECT
	pdr.pdrnotransaksi as KIMO,
	pdr.pdrtgl as KIMOTGL,
	pdr.pdruraian as DESCRIPTION,
	i1.bkode as KODEMESIN,
	pdrin.namabarang as NAMAMESIN,
	pdrin.jmlbarang as JMLMESIN,
	pdrin.satuanbarang as SATUANMESIN,
	mrs.mrssumber as SUMBER,
	mrs.mrstgl as TGL,
	mrs.mrsnotransaksi as NOTRANSAKSI,
	mrs.mrsuraian as URAIAN,
	i.bid as IDBARANG,
	i.bkode as KODE,
	mrso.namabarang as NAMA,
	(mrso.jmlbarang * 1) as JML,
	mrso.satuanbarang as SATUAN,
	mrso.hpp as HPP,
	mrso.jmlbarang * mrso.hpp as NILAI
	FROM
	m6_pdr pdr
JOIN m6_pdr_in pdrin ON pdr.pdrid = pdrin.idpdr
JOIN m1_item i1 ON pdrin.idbarang = i1.bid
JOIN m6_mrs_out mrso ON pdr.pdrnotransaksi = mrso.costcenter
JOIN m6_mrs mrs ON mrso.idmrs = mrs.mrsid
AND mrs.mrsstatus IN(2,3,4,7)
JOIN m1_item i ON mrso.idbarang = i.bid

UNION ALL

SELECT
	pdr.pdrnotransaksi as KIMO,
	pdr.pdrtgl as KIMOTGL,
	pdr.pdruraian as DESCRIPTION,
	i1.bkode as KODEMESIN,
	pdrin.namabarang as NAMAMESIN,
	pdrin.jmlbarang as JMLMESIN,
	pdrin.satuanbarang as SATUANMESIN,
	grn.grnsumber as SUMBER,
	grn.grntgl as TGL,
	grn.grnnotransaksi as NOTRANSAKSI,
	grn.grnuraian as URAIAN,
	i.bid as IDBARANG,
	i.bkode as KODE,
	grno.namabarang as NAMA,
	(grno.jmlbarang * 1) as JML,
	grno.satuanbarang as SATUAN,
	(((grno.jml * grno.harga) - grno.jmldiskon) / grno.jmlbarang) * grno.kurs as HPP,
	((grno.jml * grno.harga) - grno.jmldiskon) * grno.kurs as NILAI
	FROM
	m6_pdr pdr
JOIN m6_pdr_in pdrin ON pdr.pdrid = pdrin.idpdr
JOIN m1_item i1 ON pdrin.idbarang = i1.bid
JOIN m4_grn_detail grno ON pdr.pdrnotransaksi = grno.costcenter
JOIN m4_grn grn ON grno.idgrn = grn.grnid
AND grn.grnstatus IN(2,3,4,7)
JOIN m1_item i ON grno.idbarang = i.bid

UNION ALL

SELECT
	pdr.pdrnotransaksi as KIMO,
	pdr.pdrtgl as KIMOTGL,
	pdr.pdruraian as DESCRIPTION,
	i1.bkode as KODEMESIN,
	pdrin.namabarang as NAMAMESIN,
	pdrin.jmlbarang as JMLMESIN,
	pdrin.satuanbarang as SATUANMESIN,
	sa.sasumber as SUMBER,
	sa.satgl as TGL,
	sa.sanotransaksi as NOTRANSAKSI,
	CONCAT(sa.sauraian, '(', IFNULL(mrs.mrsnotransaksi,''),')') as URAIAN,
	i.bid as IDBARANG,
	i.bkode as KODE,
	sao.namabarang as NAMA,
	(sao.jmlbarangkeluar - sao.jmlbarangmasuk) * 1 as JML,
	sao.satuanbarang as SATUAN,
	sao.hpp as HPP,
	(sao.jmlbarangkeluar - sao.jmlbarangmasuk) * sao.hpp as NILAI
	FROM
	m6_pdr pdr
JOIN m6_pdr_in pdrin ON pdr.pdrid = pdrin.idpdr
JOIN m1_item i1 ON pdrin.idbarang = i1.bid
JOIN m3_sa_detail sao ON pdr.pdrnotransaksi = sao.costcenter AND sao.reklawan = '110301.003'
JOIN m3_sa sa ON sao.idsa = sa.said
AND sa.sastatus IN(2,3,4,7)
JOIN m1_item i ON sao.idbarang = i.bid
LEFT JOIN m6_mrs_out mrso ON sao.customdbl3 = mrso.idmrsout
LEFT JOIN m6_mrs mrs ON mrso.idmrs = mrs.mrsid
) as wip
LEFT JOIN 
(SELECT
	grnd.idbarang,
	SUBSTRING_INDEX(
	GROUP_CONCAT(grnd.harga * grnd.kurs ORDER BY grn.grntgl DESC, grn.grnnotransaksi DESC, grn.grnid DESC, grnd.urutan DESC)
,',',1) as harga,
SUBSTRING_INDEX(
GROUP_CONCAT(grnd.harga ORDER BY grn.grntgl DESC, grn.grnnotransaksi DESC, grn.grnid DESC, grnd.urutan DESC)
,',',1) as hargacurr,
SUBSTRING_INDEX(
GROUP_CONCAT(grnd.matauang ORDER BY grn.grntgl DESC, grn.grnnotransaksi DESC, grn.grnid DESC, grnd.urutan DESC)
,',',1) as matauang 
FROM m4_grn_detail grnd
JOIN m4_grn grn ON grnd.idgrn = grn.grnid
AND grn.grnstatus IN(2,3,4,7)
GROUP BY grnd.idbarang) as lgrn ON wip.idbarang = lgrn.idbarang
LEFT JOIN m5_so_detail sod ON wip.kimo = sod.customtext3
LEFT JOIN m5_so so ON sod.idso = so.soid
LEFT JOIN m5_si_detail sid ON sod.idsodetail = sid.idsodetail
LEFT JOIN m1_currency cr ON sod.matauang = cr.ckode		
LEFT JOIN m1_contact c ON so.sobagianpenjualan = c.kid
WHERE (kimotgl BETWEEN '2017-08-30' AND '2017-10-30')
GROUP BY wip.KIMO, wip.IDBARANG	
ORDER BY wip.KIMOTGL, wip.KIMO, wip.SUMBER, wip.TGL, wip.NOTRANSAKSI, wip.KODE
</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatQty Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatQty</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatJmlReport"</SqlCommand>
      </formatQty>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 6 AND sgrup = "company" AND skode = "FormatMinusReportPD"</SqlCommand>
      </formatMinus>
      <formatNominal Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
 snilai , 
 CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

 FROM m0_setting 

 WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
