  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <BusinessObjects isList="true" count="0" />
    <Databases isList="true" count="1">
      <myerpplus Ref="2" type="Stimulsoft.Report.Dictionary.StiOdbcDatabase" isKey="true">
        <Alias>myerpplus</Alias>
        <ConnectionString>dsn=myerpplus-product</ConnectionString>
        <Name>myerpplus</Name>
      </myerpplus>
    </Databases>
    <DataSources isList="true" count="5">
      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="13">
          <value>bkategori,System.String</value>
          <value>bkode,System.String</value>
          <value>bnama,System.String</value>
          <value>stok,System.Double</value>
          <value>bsatuan,System.String</value>
          <value>masuk,System.String</value>
          <value>keluar,System.String</value>
          <value>aging,System.Int32</value>
          <value>tgl,System.String</value>
          <value>gudang,System.String</value>
          <value>wnama,System.String</value>
          <value>hpp,System.Double</value>
          <value>nilai,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
@tglaging as tgl,
tb.gudang,
wh.wnama,
i.bkategori,
i.bkode,
i.bnama,
SUM(
(CASE tb.jenismutasi
WHEN 1 THEN tb.jmlbarang
ELSE tb.jmlbarang * -1
END)
) as stok,
i.bsatuan,
IFNULL(h.hpp,0) as hpp,
SUM(
(CASE tb.jenismutasi
WHEN 1 THEN tb.jmlbarang
ELSE tb.jmlbarang * -1
END)
) * IFNULL(h.hpp,0) as nilai,
IFNULL(ms.tglmasuk,'2017-07-31') as masuk,
IFNULL(kl.tglkeluar,'-') as keluar,
DATEDIFF(@tglaging,IFNULL(ms.tglmasuk,'2017-07-31')) as aging
FROM m1_item_transaction tb
JOIN m1_item i ON tb.idbarang = i.bid AND i.bkategori = 'Raw Materials'
JOIN m1_warehouse wh ON tb.gudang = wh.wkode AND tb.gudang = 'GW'
LEFT JOIN 0_hppglobal h ON tb.idbarang = h.id
LEFT JOIN
(SELECT idbarang, MAX(tgl) as tglmasuk FROM m1_item_transaction
, (SELECT @tglaging := '2017-10-31') as VariableInit1
WHERE jenismutasi = 1
AND sumber IN('IB','GRN','RI')
AND tgl &lt;= @tglaging
AND gudang = 'GW'

GROUP BY idbarang
) as ms ON tb.idbarang = ms.idbarang
LEFT JOIN
(SELECT idbarang, MAX(tgl) as tglkeluar FROM m1_item_transaction
, (SELECT @tglaging := '2017-10-31') as VariableInit2
WHERE jenismutasi = 0
#AND sumber IN('IB','GRN','RI')
AND tgl &lt;= @tglaging
AND gudang = 'GW'
GROUP BY idbarang
) as kl ON tb.idbarang = kl.idbarang
, (SELECT @tglaging := '2017-10-31') as VariableInit
GROUP BY tb.idbarang
ORDER BY i.bkode
</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"	</SqlCommand>
      </formatMinus>
