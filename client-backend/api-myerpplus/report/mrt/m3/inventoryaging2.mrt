      <DS1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DS1</Alias>
        <Columns isList="true" count="19">
          <value>IDLOGIN,System.String</value>
          <value>ITEMCATEGORY,System.String</value>
          <value>ITEMID,System.Int64</value>
          <value>ITEMCODE,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>UOM,System.String</value>
          <value>TGL,System.DateTime</value>
          <value>AGING,System.Double</value>
          <value>QTY,System.Double</value>
          <value>PRICE,System.Double</value>
          <value>TOTAL,System.Double</value>
          <value>ACURRENT,System.Double</value>
          <value>A1_30,System.Double</value>
          <value>A31_60,System.Double</value>
          <value>A61_90,System.Double</value>
          <value>A91_360,System.Double</value>
          <value>A361_720,System.Double</value>
          <value>A721_1080,System.Double</value>
          <value>A1081_,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DS1</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	idlogin as IDLOGIN,
	kskategoribarang as ITEMCATEGORY,
	ksidbarang AS ITEMID,
	kskodebarang AS ITEMCODE,
	ksnamabarang AS ITEMDESC,
	kssatuanbarang AS UOM,
	kstgl AS TGL,
	kskurs AS AGING,
	kssaldojml AS QTY,
	kshargamasuk AS PRICE,
	kssaldonilai AS TOTAL,
	kscustomdbl1 AS ACURRENT,
	kscustomdbl2 AS A1_30,
kscustomdbl3 AS A31_60,
kscustomdbl4 AS A61_90,
kscustomdbl5 AS A91_360,
kscustomdbl6 AS A361_720,
kscustomdbl7 AS A721_1080,
kscustomdbl8 AS A1081_
FROM
m2r_inventory_aging		
ORDER BY kskategoribarang ASC, kskodebarang ASC, kstgl ASC, kssumber ASC, ksnotransaksi ASC, ksid ASC
</SqlCommand>
      </DS1>
      <formatTgl Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatTgl</Alias>
        <Columns isList="true" count="2">
          <value>snilai,System.String</value>
          <value>format,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatTgl</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT

	snilai , CONCAT('{0:',(replace(
	REPLACE(
	REPLACE(snilai,'D','d'),'m','M'),'Y','y') ) ,'}')
	as format

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatTanggalReport"</SqlCommand>
      </formatTgl>
      <formatNominal Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatNominal</Alias>
        <Columns isList="true" count="6">
          <value>skode,System.String</value>
          <value>digitGrup,System.String</value>
          <value>pemisahDesimal,System.String</value>
          <value>digitDesimal,System.Decimal</value>
          <value>snilai,System.String</value>
          <value>fromat,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatNominal</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , 
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 1), '|', -1) as digitGrup,
	SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 2), '|', -1) as pemisahDesimal,
	CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED) as digitDesimal,
	snilai , 
	CONCAT('{0:N',(CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(snilai, '|', 3), '|', -1) as UNSIGNED)),'}') AS fromat

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatNominalReport"</SqlCommand>
      </formatNominal>
      <formatMinus Ref="6" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatMinus</Alias>
        <Columns isList="true" count="4">
          <value>skode,System.String</value>
          <value>snilai,System.String</value>
          <value>kiri,System.String</value>
          <value>kanan,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>formatMinus</Name>
        <NameInSource>myerpplus</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
	skode , snilai , 
	SUBSTR(snilai FROM 1 FOR 1) AS kiri , 
	SUBSTR(snilai FROM 2 FOR 1) AS kanan 
	

	FROM m0_setting 

	WHERE smodule = 0 AND sgrup = "company" AND skode = "FormatMinusReport"	</SqlCommand>
      </formatMinus>
      <formatQty Ref="7" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>formatQty</Alias>
        <Columns isList="true" count="6">
