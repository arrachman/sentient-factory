{
  "name": "@sentient-factory/ui-kit",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "if [ -f tsconfig.json ]; then tsc; else echo 'No tsconfig.json, skipping build'; fi",
    "dev": "if [ -f tsconfig.json ]; then tsc --watch; else echo 'No tsconfig.json, skipping dev'; fi",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "typecheck": "if [ -f tsconfig.json ]; then tsc --noEmit; else echo 'No tsconfig.json, skipping typecheck'; fi",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sentient-factory/shared-types": "*",
    "@sentient-factory/logger": "*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.309.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.5.0",
    "@storybook/addon-interactions": "^7.5.0",
    "@storybook/addon-links": "^7.5.0",
    "@storybook/blocks": "^7.5.0",
    "@storybook/react": "^7.5.0",
    "@storybook/react-vite": "^7.5.0",
    "@storybook/test": "^7.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "storybook": "^7.5.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
