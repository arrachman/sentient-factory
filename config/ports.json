{
  "apps": {
    "web-dashboard": {
      "name": "Web Dashboard",
      "port": 3201,
      "type": "nextjs",
      "envVar": "WEB_DASHBOARD_PORT",
      "description": "Main administration dashboard",
      "isActive": true
    },
    "web-althea": {
      "name": "Web Althea",
      "port": 3202,
      "type": "nextjs",
      "envVar": "WEB_ALTHEA_PORT",
      "description": "Althea Psychology booking app (6 internal staff roles)",
      "productionUrl": "http://althea.fr-labs.my.id/",
      "isActive": true
    },
    "landing-page": {
      "name": "Landing Page",
      "port": 3102,
      "type": "nextjs",
      "envVar": "LANDING_PAGE_PORT",
      "description": "Marketing landing page",
      "isActive": false
    },
    "api-gateway": {
      "name": "API Gateway",
      "port": 3203,
      "type": "nestjs",
      "envVar": "API_GATEWAY_PORT",
      "description": "Backend API server (shared ERP + Clinic via /clinic/* namespace)",
      "productionUrl": "http://althea.fr-labs.my.id/api",
      "isActive": true
    },
    "ai-engine": {
      "name": "AI Engine",
      "port": 8001,
      "type": "python",
      "envVar": "AI_ENGINE_PORT",
      "description": "AI processing service",
      "isActive": true
    }
  },
  "services": {
    "docs": {
      "name": "Documentation",
      "port": 3205,
      "type": "docs",
      "envVar": "DOCS_PORT",
      "description": "Project documentation",
      "isActive": true
    },
    "hr-marketing": {
      "name": "HR Marketing",
      "port": 3209,
      "type": "static",
      "description": "Static marketing page for HR module",
      "isActive": true
    },
    "sentient-marketing": {
      "name": "Sentient Marketing",
      "port": 3210,
      "type": "static",
      "description": "Static marketing page for Sentient Factory",
      "isActive": true
    },
    "tarik-data-digital": {
      "name": "Tarik Data Digital",
      "port": 3211,
      "type": "static",
      "description": "Static company profile page for Tarik Data Digital",
      "isActive": true
    },
    "kafka-ui": {
      "name": "Kafka UI",
      "port": 3212,
      "type": "kafka-ui",
      "description": "Kafka cluster web interface",
      "isActive": true
    },
    "postgres": {
      "port": 3208,
      "description": "PostgreSQL database"
    },
    "redis": {
      "port": 3213,
      "description": "Redis cache"
    },
    "mysql": {
      "port": 3307,
      "description": "MySQL database"
    },
    "vault": {
      "port": 8200,
      "description": "HashiCorp Vault dev server"
    },
    "kafka": {
      "port": 9092,
      "description": "Apache Kafka broker"
    },
    "kafka-external": {
      "port": 29092,
      "description": "Apache Kafka external listener"
    },
    "debezium-connect": {
      "port": 8083,
      "description": "Debezium Kafka Connect service"
    },
    "influxdb": {
      "port": 8086,
      "description": "InfluxDB time-series database"
    },
    "rabbitmq": {
      "port": 5672,
      "description": "RabbitMQ message broker"
    },
    "minio": {
      "port": 9000,
      "description": "MinIO object storage"
    },
    "grafana": {
      "port": 3006,
      "description": "Grafana monitoring dashboard"
    },
    "prometheus": {
      "port": 9090,
      "description": "Prometheus metrics"
    }
  },
  "defaults": {
    "nextjs": 3000,
    "fastify": 3000,
    "node": 3000,
    "docs": 3000
  }
}
