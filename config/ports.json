{
  "apps": {
    "web-dashboard": {
      "name": "Web Dashboard",
      "port": 3201,
      "type": "nextjs",
      "envVar": "WEB_DASHBOARD_PORT",
      "description": "Main administration dashboard",
      "isActive": true
    },
    "landing-page": {
      "name": "Landing Page",
      "port": 3102,
      "type": "nextjs",
      "envVar": "LANDING_PAGE_PORT",
      "description": "Marketing landing page",
      "isActive": false
    },
    "api-gateway": {
      "name": "API Gateway",
      "port": 3203,
      "type": "nestjs",
      "envVar": "API_GATEWAY_PORT",
      "description": "Backend API server (shared by ERP + MDP)",
      "productionUrl": "http://erp.fr-labs.my.id/api",
      "isActive": true
    },
    "ai-engine": {
      "name": "AI Engine",
      "port": 8001,
      "type": "python",
      "envVar": "AI_ENGINE_PORT",
      "description": "AI processing service",
      "isActive": true
    },
    "web-erp": {
      "name": "Web ERP (Prototype)",
      "port": 3219,
      "type": "static",
      "envVar": "WEB_ERP_PORT",
      "description": "Sentient ERP design prototype (static HTML/CSS)",
      "isActive": true
    },
    "web-mdp": {
      "name": "Web MDP",
      "port": 3220,
      "type": "nextjs",
      "envVar": "WEB_MDP_PORT",
      "description": "Senti MDP — Manufacturing Digitalization Platform (ISA-95 Level 3 / MOM)",
      "isActive": true
    },
    "web-hr": {
      "name": "Web HR",
      "port": 3209,
      "type": "nextjs",
      "envVar": "WEB_HR_PORT",
      "description": "Senti HR — Time & Attendance / Workforce Management (jibble.io adaptation, first clean ui-kit adopter)",
      "productionUrl": "http://hr.fr-labs.my.id",
      "isActive": true
    }
  },
  "services": {
    "docs": {
      "name": "Documentation",
      "port": 3205,
      "type": "docs",
      "envVar": "DOCS_PORT",
      "description": "Project documentation",
      "isActive": true
    },
    "hr-marketing": {
      "name": "HR Marketing",
      "port": 3221,
      "type": "static",
      "description": "Static marketing page for HR module",
      "isActive": true
    },
    "sentient-marketing": {
      "name": "Sentient Marketing",
      "port": 3210,
      "type": "static",
      "description": "Static marketing page for Sentient Factory",
      "isActive": true
    },
    "tarik-data-digital": {
      "name": "Tarik Data Digital",
      "port": 3211,
      "type": "static",
      "description": "Static company profile page for Tarik Data Digital",
      "isActive": true
    },
    "postgres": {
      "port": 3208,
      "description": "PostgreSQL database"
    },
    "redis": {
      "port": 3213,
      "description": "Redis cache"
    },
    "mysql": {
      "port": 3307,
      "description": "MySQL database"
    },
    "vault": {
      "port": 8200,
      "description": "HashiCorp Vault dev server"
    },
    "influxdb": {
      "port": 8086,
      "description": "InfluxDB time-series database"
    },
    "rabbitmq": {
      "port": 5672,
      "description": "RabbitMQ message broker"
    },
    "minio": {
      "port": 9000,
      "description": "MinIO object storage"
    },
    "grafana": {
      "port": 3006,
      "description": "Grafana monitoring dashboard"
    },
    "prometheus": {
      "port": 9090,
      "description": "Prometheus metrics"
    }
