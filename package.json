{
  "name": "sentient-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent manufacturing platform - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "./scripts/start-all.sh",
    "ports:list": "node scripts/port-manager.js list",
    "ports:check": "node scripts/port-manager.js check",
    "ports:find": "node scripts/port-manager.js find",
    "ports:update": "node scripts/port-manager.js update",
    "ports:toggle": "node scripts/port-manager.js toggle",
    "ports:active": "node scripts/port-manager.js active",
    "ports:env": "node scripts/port-manager.js env",
    "ports:commands": "node scripts/port-manager.js commands",
    "ports:script": "node scripts/port-manager.js script",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose -p sentient_factory -f infra/docker-compose.yml up -d",
    "docker:up:vault": "./scripts/docker-up-with-vault.sh",
    "docker:down": "docker compose -p sentient_factory -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -p sentient_factory -f infra/docker-compose.yml logs -f",
    "vault:bootstrap:dev": "./scripts/bootstrap-vault-dev.sh",
    "vault:login:dev": "./scripts/vault-login-dev.sh",
    "vault:render:root": "./scripts/render-vault-env.sh sentient-factory/dev/shared .env.vault",
    "vault:render:api": "./scripts/render-vault-env.sh sentient-factory/dev/api-gateway apps/api-gateway/.env.vault",
    "vault:render:web": "./scripts/render-vault-env.sh sentient-factory/dev/web-dashboard apps/web-dashboard/.env.vault",
    "vault:render:myerp": "./scripts/render-vault-env.sh sentient-factory/dev/myerpplus-db-mapping apps/myerpplus-db-mapping/.env.vault",
    "vault:render:all": "npm run vault:render:root && npm run vault:render:api && npm run vault:render:web && npm run vault:render:myerp",
    "env:cleanup:plain": "./scripts/cleanup-plain-env.sh",
    "db:backup": "./scripts/backup-postgres.sh",
    "db:backup:install-cron": "./scripts/install-pg-backup-cron.sh",
    "db:migrate": "cd apps/api-gateway && npm run db:migrate",
    "db:seed": "cd apps/api-gateway && npm run db:seed",
    "docs:dev": "cd docs && npm run start",
    "docs:build": "cd docs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "manufacturing",
    "ai",
    "iot",
    "industry-4.0",
    "smart-factory"
  ],
  "author": "Sentient Factory Team",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "pg": "^8.18.0"
  }
}
