{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "FILE=\"${CLAUDE_TOOL_INPUT_FILE_PATH:-}\"; if [[ -z \"$FILE\" ]]; then exit 0; fi; case \"$FILE\" in *.ts|*.tsx|*.js|*.jsx) WS=$(echo \"$FILE\" | grep -oP '/home/rania/apps/sentient-factory/(apps|packages)/[^/]+'); if [[ -n \"$WS\" && -f \"$WS/tsconfig.json\" ]]; then cd \"$WS\" && npx tsc --noEmit 2>&1 | grep -E 'error TS' | head -10; fi ;; esac"
        }]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "FILE=\"${CLAUDE_TOOL_INPUT_FILE_PATH:-}\"; case \"$FILE\" in *.ts|*.tsx|*.js|*.jsx|*.py) if [ -f \"$FILE\" ]; then LINES=$(wc -l < \"$FILE\"); if [ \"$LINES\" -gt 400 ]; then echo \"⚠️  FILE TOO LONG: $FILE has $LINES lines (limit: 400). Split into smaller modules before continuing.\"; fi; fi ;; esac"
        }]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npm ci)",
      "Bash(npx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo view*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest*)",
      "Bash(tsc*)",
      "Bash(eslint*)",
      "Bash(prettier*)",
      "Bash(turbo *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(cd *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(diff *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(for *)",
      "Bash(while *)",
      "Bash(pm2 *)",
      "Bash(systemctl *)",
      "Bash(journalctl *)",
      "Bash(curl *)",
      "Bash(TOKEN=*)",
      "Bash(sleep *)",
      "Bash(ls -la ~/.claude/ 2>/dev/null)",
      "Read(//home/rania/.claude/**)",
      "Bash(chmod 700 ~/.claude)",
      "Bash(chmod 600 ~/.claude/settings.json ~/.claude/settings.local.json)",
      "Bash(cd /home/rania/apps/sentient-factory && git stash && cd apps && npm run typecheck 2>&1 | tail -10; cd /home/rania/apps/sentient-factory && git stash pop)",
      "Bash(cd /home/rania/apps/sentient-factory && git stash push -- apps*)",
      "Bash(cd /home/rania/apps/sentient-factory/apps && grep *)",
      "Bash({ *)",
      "Skill(update-config)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(/home/rania/.claude/settings.json)",
      "Write(/home/rania/.claude/settings.json)",
      "Edit(/home/rania/apps/sentient-factory/.claude/settings.json)",
      "Write(/home/rania/apps/sentient-factory/.claude/settings.json)"
    ],
    "deny": [
