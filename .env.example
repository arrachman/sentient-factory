# Vault bootstrap controls
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_DEV_ROOT_TOKEN_ID=change-me-local-only
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_NAMESPACE=

# Shared development environment
POSTGRES_DB=sentient_factory
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://root:change_me@postgres:5432/sentient_factory
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:3203
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3203
AI_ENGINE_URL=http://127.0.0.1:8001

# Optional AI / integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PATUNGIN_API_KEY_PRIMARY=
PATUNGIN_API_KEY_SECONDARY=
PATUNGIN_API_KEY_TERTIARY=
ANTIGRAVITY_API_KEY_PRIMARY=
ANTIGRAVITY_API_KEY_SECONDARY=
DEEPSEEK_API_KEY=

# Optional email / monitoring
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
PROMETHEUS_URL=
GRAFANA_URL=

# Development
NODE_ENV=development
DEBUG=sentient-factory:*
WEB_DASHBOARD_PORT=3201
API_GATEWAY_PORT=3203
AI_ENGINE_PORT=8001
DOCS_PORT=3205
CHOKIDAR_USEPOLLING=true
