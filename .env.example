# Vault bootstrap controls
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_DEV_ROOT_TOKEN_ID=change-me-local-only
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_NAMESPACE=

# Shared development environment
POSTGRES_DB=sentient_factory
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://root:change_me@postgres:5432/sentient_factory
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:3203
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3203
AI_ENGINE_URL=http://127.0.0.1:8001

# Optional AI / integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional email / monitoring
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
PROMETHEUS_URL=
GRAFANA_URL=

# Alerting delivery
ALERTING_WA_GROUP_WEBHOOK_URL=
ALERTING_WA_GROUP_WEBHOOK_TOKEN=
ALERTING_WA_PERSONAL_WEBHOOK_URL=
ALERTING_WA_PERSONAL_WEBHOOK_TOKEN=
ALERTING_WA_BAILEYS_ENABLED=false
ALERTING_WA_BAILEYS_AUTH_DIR=
ALERTING_EMAIL_WEBHOOK_URL=
ALERTING_EMAIL_WEBHOOK_TOKEN=
ALERTING_EMAIL_SMTP_HOST=
ALERTING_EMAIL_SMTP_PORT=
ALERTING_EMAIL_SMTP_USER=
ALERTING_EMAIL_SMTP_PASS=
ALERTING_EMAIL_SMTP_SECURE=false
ALERTING_EMAIL_FROM=
ALERTING_SCHEDULER_INTERVAL_MS=60000
ALERTING_DELIVERY_INTERVAL_MS=30000

# Development
NODE_ENV=development
DEBUG=sentient-factory:*
WEB_DASHBOARD_PORT=3201
API_GATEWAY_PORT=3203
AI_ENGINE_PORT=8001
DOCS_PORT=3205
CHOKIDAR_USEPOLLING=true
