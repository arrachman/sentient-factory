# =====================================================================
# Caddy reverse proxy untuk Althea Psychology
# Domain: althea.fr-labs.my.id
# Self-host VPS dengan static IP MyRepublic (port 3202 web, 3203 api)
#
# Lihat .planning/ADRs/009-deployment-url-mapping.md untuk strategy.
# =====================================================================

# HTTP version (untuk dev / sebelum SSL set up)
althea.fr-labs.my.id:80 {
    # API gateway routes — strip /api prefix untuk forward ke api-gateway
    handle /api/* {
        reverse_proxy localhost:3203
    }

    # Webhook untuk Fonnte (Slice 8) — public endpoint, no auth
    handle /webhook/wa {
        reverse_proxy localhost:3203
    }

    # Health check
    handle /health {
        respond "OK" 200
    }

    # Default: web-althea (Next.js)
    handle {
        reverse_proxy localhost:3202
    }

    # Logging
    log {
        output file /var/log/caddy/althea.log {
            roll_size 100mb
            roll_keep 10
        }
        format json
    }

    # Headers
    header {
        # HSTS (uncomment kalau sudah HTTPS)
        # Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# =====================================================================
# HTTPS version (recommended untuk production)
# Uncomment + ganti email kalau siap deploy dengan SSL
# Caddy auto-provision Let's Encrypt cert.
# =====================================================================
