# =====================================================================
# Althea Psychology — production env (CONTOH)
# Copy ke .env.althea-prod lalu isi nilai asli. JANGAN commit file terisi.
#   cp .env.althea-prod.example .env.althea-prod
# =====================================================================

# --- PostgreSQL ---
POSTGRES_USER=althea
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=althea

# --- Auth (api-gateway) ---
# Generate: openssl rand -hex 32
JWT_SECRET=ganti_dengan_random_64_hex
JWT_EXPIRES_IN=7d

# --- CORS ---
# Origin frontend yang boleh akses api-gateway (comma-separated bila >1).
# Same-origin via reverse proxy biasanya tidak perlu, tapi isi domain publik utk aman.
CORS_ORIGIN=https://altheapsychology.co.id

# --- Frontend → API (browser) ---
# Same-origin di belakang reverse proxy. Ganti ke URL absolute hanya bila beda origin.
NEXT_PUBLIC_API_URL=/api

# --- WhatsApp via Fonnte (https://fonnte.com) ---
# Account token (Profile → API Key Account). Wajib utk endpoint pairing device in-app.
FONNTE_ACCOUNT_TOKEN=token_account_fonnte
# Per-device token (opsional bila device di-pair via UI; boleh dikosongkan).
FONNTE_API_TOKEN=
# Opsional — paket Fonnte Free tidak kirim webhook delivery, boleh dikosongkan.
FONNTE_WEBHOOK_URL=

# --- URL aplikasi (dipakai di template WA "login_url", dll) ---
WEB_ALTHEA_URL=https://altheapsychology.co.id
