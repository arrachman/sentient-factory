[Unit]
Description=Sentient Factory Docker Compose stack
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sentient-factory
ExecStart=/opt/sentient-factory/scripts/start-infra-on-boot.sh
ExecStop=/opt/sentient-factory/scripts/stop-infra-on-boot.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=default.target
