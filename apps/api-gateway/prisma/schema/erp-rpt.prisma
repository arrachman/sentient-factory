// ── Report Engine ─────────────────────────────────────────────────────────────
// Custom report templates. Template JSON menyimpan bands, components,
// dan data sources (raw SQL queries) sekaligus.

model ErpRptTemplate {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @map("code")
  name        String    @map("name")
  module      String    @map("module")
  description String?   @map("description")
  templateJson Json     @map("template_json")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?   @map("created_by_id")
  updatedById BigInt?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([module])
  @@index([isActive])
  @@map("rpt_templates")
}
