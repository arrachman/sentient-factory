  cogsAccountId             BigInt?          @map("cogs_account_id")
  salesReturnAccountId      BigInt?          @map("sales_return_account_id")
  salesDiscountAccountId    BigInt?          @map("sales_discount_account_id")
  purchaseReturnAccountId   BigInt?          @map("purchase_return_account_id")
  purchaseDiscountAccountId BigInt?          @map("purchase_discount_account_id")
  consignmentAccountId      BigInt?          @map("consignment_account_id")
  purchaseTaxId             BigInt?          @map("purchase_tax_id")
  saleTaxId                 BigInt?          @map("sale_tax_id")
  primarySupplierId         BigInt?          @map("primary_supplier_id")
  weight                    Decimal?         @map("weight") @db.Decimal(19, 4)
  length                    Decimal?         @map("length") @db.Decimal(19, 4)
  width                     Decimal?         @map("width") @db.Decimal(19, 4)
  height                    Decimal?         @map("height") @db.Decimal(19, 4)
  volume                    Decimal?         @map("volume") @db.Decimal(19, 4)
  conversionKgPcs           Decimal          @default(1) @map("conversion_kg_pcs") @db.Decimal(19, 4)
  registrationNo            String?          @map("registration_no")
  isReturnable              Boolean          @default(true) @map("is_returnable")
  isMobile                  Boolean          @default(false) @map("is_mobile")
  ageCategory               String?          @map("age_category")
  validUntil                DateTime?        @map("valid_until") @db.Date
