  purchaseReturnAccount   ErpAccount?          @relation("ItemPurchaseReturnAcct", fields: [purchaseReturnAccountId], references: [id])
  purchaseDiscountAccount ErpAccount?          @relation("ItemPurchaseDiscountAcct", fields: [purchaseDiscountAccountId], references: [id])
  consignmentAccount      ErpAccount?          @relation("ItemConsignmentAcct", fields: [consignmentAccountId], references: [id])
  purchaseTax             ErpTax?              @relation("ItemPurchaseTax", fields: [purchaseTaxId], references: [id])
  saleTax                 ErpTax?              @relation("ItemSaleTax", fields: [saleTaxId], references: [id])
  primarySupplier         ErpPartner?          @relation("ItemPrimarySupplier", fields: [primarySupplierId], references: [id])
  vendor                  ErpPartner?          @relation("ItemVendor", fields: [vendorId], references: [id])
