  metadata            Json?     @map("metadata")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById         BigInt?   @map("created_by_id")
  updatedById         BigInt?   @map("updated_by_id")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  category          ErpPartnerCategory? @relation(fields: [categoryId], references: [id])
  currency          ErpCurrency?        @relation(fields: [currencyId], references: [id])
  receivableAccount ErpAccount?         @relation("PartnerReceivableAcct", fields: [receivableAccountId], references: [id])
  payableAccount    ErpAccount?         @relation("PartnerPayableAcct", fields: [payableAccountId], references: [id])
  saleTerm          ErpPaymentTerm?     @relation("PartnerSaleTerm", fields: [saleTermId], references: [id])
  purchaseTerm      ErpPaymentTerm?     @relation("PartnerPurchaseTerm", fields: [purchaseTermId], references: [id])
  salesman          ErpPartner?         @relation("PartnerSalesman", fields: [salesmanId], references: [id])
  branch            ErpBranch?          @relation(fields: [branchId], references: [id])

  addresses           ErpPartnerAddress[]
  contacts            ErpPartnerContact[]
  bankAccounts        ErpPartnerBankAccount[]
  salesmanOfPartners  ErpPartner[]            @relation("PartnerSalesman")
  itemPrimarySupplier ErpItem[]               @relation("ItemPrimarySupplier")
  itemDistributors    ErpItemDistributor[]    @relation("ItemDistributorPartner")
  itemVendor          ErpItem[]               @relation("ItemVendor")

  @@index([categoryId])
  @@index([currencyId])
  @@index([salesmanId])
  @@index([legacyCode])
  @@map("md_partners")
}

model ErpPartnerAddress {
