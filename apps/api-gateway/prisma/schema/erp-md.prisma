  @@index([kindId])
  @@index([productClassId])
  @@index([brandId])
  @@index([materialId])
  @@index([itemModelId])
  @@index([sizeId])
  @@index([colorId])
  @@index([sectionId])
  @@index([designerId])
  @@index([nozzleId])
  @@index([oemId])
  @@index([vendorId])
  @@index([fieldUnitId])
  @@index([divisionId])
  @@index([departmentId])
  @@index([branchId])
  @@index([defaultLocationId])
  @@index([defaultWarehouseId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([barcode])
  @@index([legacyCode])
  @@map("md_items")
}

/// Sale price tiers per item (legacy MyERP+ "Harga Jual 1..10" + "Diskon Jual 1..10").
/// One row per (item, level 1..10). Level 1 mirrors ErpItem.salePrice (denormalized cache).
model ErpItemPrice {
  id              BigInt   @id @default(autoincrement())
  itemId          BigInt   @map("item_id")
  level           Int      @map("level")
  price           Decimal  @default(0) @map("price") @db.Decimal(19, 4)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(9, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     BigInt?  @map("created_by_id")
  updatedById     BigInt?  @map("updated_by_id")

  item ErpItem @relation("ItemPrices", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, level])
  @@index([itemId])
  @@map("md_item_prices")
}

/// Item storage placements per item (legacy MyERP+ "Lokasi" tab = m1_item_location_warehouse).
/// One row per (item, warehouse, location) — multi placement beyond defaultWarehouse/defaultLocation.
/// NB: named `ErpItemPlacement`/`md_item_placements` — `ErpItemLocation`/`md_item_locations`
/// is already the legacy "Item Location" master (code/name) with its own module + data.
model ErpItemPlacement {
  id          BigInt   @id @default(autoincrement())
  itemId      BigInt   @map("item_id")
  warehouseId BigInt   @map("warehouse_id")
  locationId  BigInt   @map("location_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")

  item      ErpItem         @relation("ItemPlacements", fields: [itemId], references: [id], onDelete: Cascade)
  warehouse ErpWarehouse    @relation("ItemPlacementWarehouse", fields: [warehouseId], references: [id])
  location  ErpItemLocation @relation("ItemPlacementLocation", fields: [locationId], references: [id])

  @@unique([itemId, warehouseId, locationId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([locationId])
  @@map("md_item_placements")
}

/// Item branch assignments per item (legacy MyERP+ item master "Branch" tab).
/// One row per (item, branch) carrying a required cost center (Cabang + Cost Center).
/// Complements the single home branchId/costCenterId on md_items — those stay the
/// primary/default dimension; this lists the item's branch placements. Both FK to
/// md masters (intra-domain enforced); cascade on item delete, restrict the masters.
model ErpItemBranch {
  id           BigInt   @id @default(autoincrement())
  itemId       BigInt   @map("item_id")
  branchId     BigInt   @map("branch_id")
  costCenterId BigInt   @map("cost_center_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by_id")
  updatedById  BigInt?  @map("updated_by_id")

  item       ErpItem       @relation("ItemBranches", fields: [itemId], references: [id], onDelete: Cascade)
  branch     ErpBranch     @relation("ItemBranchBranch", fields: [branchId], references: [id])
  costCenter ErpCostCenter @relation("ItemBranchCostCenter", fields: [costCenterId], references: [id])

  @@unique([itemId, branchId])
  @@index([itemId])
  @@index([branchId])
  @@index([costCenterId])
  @@map("md_item_branches")
}

/// Item distributors per item (legacy MyERP+ "Distributor" tab = m1_item_supplier).
/// One row per (item, partner) — the supplier/distributor partners that supply this item.
/// partner_id -> md_partners (filtered to is_supplier on the UI). Multi-row beyond the
/// single primarySupplierId on md_items. sortOrder keeps the legacy display order.
model ErpItemDistributor {
  id          BigInt   @id @default(autoincrement())
  itemId      BigInt   @map("item_id")
  partnerId   BigInt   @map("partner_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")

  item    ErpItem    @relation("ItemDistributors", fields: [itemId], references: [id], onDelete: Cascade)
  partner ErpPartner @relation("ItemDistributorPartner", fields: [partnerId], references: [id])

  @@unique([itemId, partnerId])
  @@index([itemId])
  @@index([partnerId])
  @@map("md_item_distributors")
}

model ErpPartnerCategory {
