model ErpCurrencyRate {
  id          BigInt   @id @default(autoincrement())
  currencyId  BigInt   @map("currency_id")
  rateDate    DateTime @map("rate_date") @db.Date
  rate        Decimal  @map("rate") @db.Decimal(19, 6)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")

