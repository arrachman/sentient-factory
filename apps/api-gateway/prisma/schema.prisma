model ErpAccount {
  id               BigInt               @id @default(autoincrement())
  code             String               @unique @map("code")
  name             String               @map("name")
  alias            String?              @map("alias")
  type             ErpAccountType       @map("type")
  kind             ErpAccountKind       @map("kind")
  normalBalance    ErpNormalBalance     @map("normal_balance")
  parentId         BigInt?              @map("parent_id")
  level            Int                  @map("level")
  cashFlowCategory ErpCashFlowCategory? @map("cash_flow_category")
  currencyId       BigInt?              @map("currency_id")
  isControlAccount Boolean              @default(false) @map("is_control_account")
  bankName         String?              @map("bank_name")
  bankAccountNo    String?              @map("bank_account_no")
  openingBalance   Decimal              @default(0) @map("opening_balance") @db.Decimal(19, 4)
  isActive         Boolean              @default(true) @map("is_active")
  notes            String?              @map("notes")
  legacyCode       String?              @map("legacy_code")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      BigInt?              @map("created_by_id")
  updatedById      BigInt?              @map("updated_by_id")
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)

  parent   ErpAccount?  @relation("AccountParent", fields: [parentId], references: [id])
  children ErpAccount[] @relation("AccountParent")
  currency ErpCurrency? @relation(fields: [currencyId], references: [id])

  itemCatInventory  ErpItemCategory[] @relation("ItemCatInventoryAcct")
  itemCatCogs       ErpItemCategory[] @relation("ItemCatCogsAcct")
  itemCatSales      ErpItemCategory[] @relation("ItemCatSalesAcct")
  itemInventory     ErpItem[]         @relation("ItemInventoryAcct")
  itemSales         ErpItem[]         @relation("ItemSalesAcct")
  itemCogs          ErpItem[]         @relation("ItemCogsAcct")
  taxSale           ErpTax[]          @relation("TaxSaleAcct")
  taxPurchase       ErpTax[]          @relation("TaxPurchaseAcct")
  partnerReceivable ErpPartner[]      @relation("PartnerReceivableAcct")
  partnerPayable    ErpPartner[]      @relation("PartnerPayableAcct")

  @@index([parentId])
  @@index([currencyId])
  @@index([legacyCode])
  @@map("md_accounts")
}

model ErpTax {
  id                BigInt    @id @default(autoincrement())
  code              String    @unique @map("code")
  name              String    @map("name")
  rate              Decimal   @map("rate") @db.Decimal(9, 4)
  saleAccountId     BigInt?   @map("sale_account_id")
  purchaseAccountId BigInt?   @map("purchase_account_id")
  isActive          Boolean   @default(true) @map("is_active")
  legacyCode        String?   @map("legacy_code")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       BigInt?   @map("created_by_id")
  updatedById       BigInt?   @map("updated_by_id")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  saleAccount     ErpAccount? @relation("TaxSaleAcct", fields: [saleAccountId], references: [id])
  purchaseAccount ErpAccount? @relation("TaxPurchaseAcct", fields: [purchaseAccountId], references: [id])
  itemPurchaseTax ErpItem[]   @relation("ItemPurchaseTax")
  itemSaleTax     ErpItem[]   @relation("ItemSaleTax")

  @@index([legacyCode])
  @@map("md_taxes")
}

model ErpPaymentTerm {
