  primarySupplier  ErpPartner?     @relation("ItemPrimarySupplier", fields: [primarySupplierId], references: [id])

  @@index([categoryId])
  @@index([baseUnitId])
  @@index([barcode])
  @@index([legacyCode])
  @@map("md_items")
}

model ErpPartnerCategory {
  id          BigInt                 @id @default(autoincrement())
  code        String                 @unique @map("code")
  name        String                 @map("name")
  kind        ErpPartnerCategoryKind @map("kind")
  salesTier   Int?                   @map("sales_tier")
  isActive    Boolean                @default(true) @map("is_active")
  legacyCode  String?                @map("legacy_code")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?                @map("created_by_id")
  updatedById BigInt?                @map("updated_by_id")
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(6)

  partners ErpPartner[]

  @@index([legacyCode])
  @@map("md_partner_categories")
}

model ErpPartner {
  id                  BigInt    @id @default(autoincrement())
  code                String    @unique @map("code")
  name                String    @map("name")
  isCustomer          Boolean   @default(false) @map("is_customer")
  isSupplier          Boolean   @default(false) @map("is_supplier")
  isSalesman          Boolean   @default(false) @map("is_salesman")
  categoryId          BigInt?   @map("category_id")
  taxNumber           String?   @map("tax_number")
  isTaxable           Boolean   @default(false) @map("is_taxable")
  currencyId          BigInt?   @map("currency_id")
  receivableAccountId BigInt?   @map("receivable_account_id")
  payableAccountId    BigInt?   @map("payable_account_id")
  arCreditLimit       Decimal?  @map("ar_credit_limit") @db.Decimal(19, 4)
  apCreditLimit       Decimal?  @map("ap_credit_limit") @db.Decimal(19, 4)
  saleTermId          BigInt?   @map("sale_term_id")
  purchaseTermId      BigInt?   @map("purchase_term_id")
  salesmanId          BigInt?   @map("salesman_id")
  commissionRate      Decimal?  @map("commission_rate") @db.Decimal(9, 4)
  branchId            BigInt?   @map("branch_id")
  isActive            Boolean   @default(true) @map("is_active")
  legacyCode          String?   @map("legacy_code")
  metadata            Json?     @map("metadata")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById         BigInt?   @map("created_by_id")
  updatedById         BigInt?   @map("updated_by_id")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  category          ErpPartnerCategory? @relation(fields: [categoryId], references: [id])
  currency          ErpCurrency?        @relation(fields: [currencyId], references: [id])
  receivableAccount ErpAccount?         @relation("PartnerReceivableAcct", fields: [receivableAccountId], references: [id])
  payableAccount    ErpAccount?         @relation("PartnerPayableAcct", fields: [payableAccountId], references: [id])
  saleTerm          ErpPaymentTerm?     @relation("PartnerSaleTerm", fields: [saleTermId], references: [id])
  purchaseTerm      ErpPaymentTerm?     @relation("PartnerPurchaseTerm", fields: [purchaseTermId], references: [id])
  salesman          ErpPartner?         @relation("PartnerSalesman", fields: [salesmanId], references: [id])
  branch            ErpBranch?          @relation(fields: [branchId], references: [id])

  addresses           ErpPartnerAddress[]
  contacts            ErpPartnerContact[]
  bankAccounts        ErpPartnerBankAccount[]
  salesmanOfPartners  ErpPartner[]        @relation("PartnerSalesman")
  itemPrimarySupplier ErpItem[]           @relation("ItemPrimarySupplier")

  @@index([categoryId])
  @@index([currencyId])
  @@index([salesmanId])
  @@index([legacyCode])
  @@map("md_partners")
}

model ErpPartnerAddress {
  id           BigInt         @id @default(autoincrement())
  partnerId    BigInt         @map("partner_id")
  type         ErpAddressType @map("type")
  isDefault    Boolean        @default(false) @map("is_default")
  addressLine1 String         @map("address_line1")
  addressLine2 String?        @map("address_line2")
  city         String?        @map("city")
  province     String?        @map("province")
  country      String?        @map("country")
  postalCode   String?        @map("postal_code")
  phone        String?        @map("phone")
  fax          String?        @map("fax")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?        @map("created_by_id")
  updatedById  BigInt?        @map("updated_by_id")
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

