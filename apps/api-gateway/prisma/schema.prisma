generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id(map: "user_pkey") @default(autoincrement())
  uuid         String    @unique @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String?   @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  roles       UserRole[]
  departments UserDepartment[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@map("m0_users")
}

model Role {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  permissions RolePermission[]
  users       UserRole[]
  menus       RoleMenu[]

  @@map("m0_role")
}

model Menu {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(cuid())
  key            String    @unique
  title          String
  path           String?
  icon           String?
  type           String    @default("ITEM")
  parentId       String?   @map("parent_id")
  sortOrder      Int       @default(0) @map("sort_order")
  isVisible      Boolean   @default(true) @map("is_visible")
  isActive       Boolean   @default(true) @map("is_active")
  permissionName String?   @map("permission_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  parent   Menu?      @relation("MenuHierarchy", fields: [parentId], references: [uuid])
  children Menu[]     @relation("MenuHierarchy")
  roles    RoleMenu[]

  @@index([parentId, sortOrder])
  @@map("m0_menu")
}

model RoleMenu {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  roleId     String    @map("role_id")
  menuId     String    @map("menu_id")
  canView    Boolean   @default(true) @map("can_view")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  role Role @relation(fields: [roleId], references: [uuid])
  menu Menu @relation(fields: [menuId], references: [uuid])

  @@unique([roleId, menuId])
  @@map("m0_role_menu")
}

model Permission {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String    @unique
  description String?
  module      String
  action      String
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  roles RolePermission[]

  @@map("m0_permission")
}

model RolePermission {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(cuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  role       Role       @relation(fields: [roleId], references: [uuid])
  permission Permission @relation(fields: [permissionId], references: [uuid])

  @@unique([roleId, permissionId])
  @@map("m0_role_permission")
}

model Department {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String
  code        String    @unique
  description String?
  parentId    String?   @map("parent_id")
  managerId   String?   @map("manager_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  parent   Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [uuid])
  children Department[]     @relation("DepartmentHierarchy")
  users    UserDepartment[]

  @@map("m0_department")
}

model UserRole {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  user User @relation(fields: [userId], references: [uuid])
  role Role @relation(fields: [roleId], references: [uuid])

  @@unique([userId, roleId])
  @@map("m0_user_role")
}

model UserDepartment {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(cuid())
  userId       String    @map("user_id")
  departmentId String    @map("department_id")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  user       User       @relation(fields: [userId], references: [uuid])
  department Department @relation(fields: [departmentId], references: [uuid])

  @@unique([userId, departmentId])
  @@map("m0_user_department")
}

model MasterDataContact {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @default(cuid())
  code             String    @unique
  name             String
  tax              String?
  website          String?
  address          String?
  street           String?
  city             String?
  province         String?
  zipCode          String?   @map("zip_code")
  type             String
  contactFirstName String?   @map("contact_first_name")
  contactEmail     String?   @map("contact_email")
  contactPhone     String?   @map("contact_phone")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")
  deliveryOrders   DeliveryOrder[]

  @@map("m1_contact")
}

model MasterDataUom {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  code      String    @unique
  name      String
  type      String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  items     MasterDataItem[]

  @@map("m1_uom")
}

model MasterDataDivision {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  @@map("m1_division")
}

model MasterDataProvince {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  name      String
  isoCode   String    @unique @map("iso_code")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  cities    MasterDataCity[]

  @@map("m1_province")
}

model MasterDataCity {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  provinceId String    @map("province_id")
  name       String
  postalCode String    @map("postal_code")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  province   MasterDataProvince   @relation(fields: [provinceId], references: [uuid])
  warehouses MasterDataWarehouse[]
  deliveryOrders DeliveryOrder[]  @relation("DoDestinationCity")

  @@map("m1_city")
}

model MasterDataWarehouse {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(cuid())
  name          String
  cityId        String    @map("city_id")
  locationName  String?   @map("location_name")
  addressDetail String?   @map("address_detail")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
  city          MasterDataCity @relation(fields: [cityId], references: [uuid])

  @@map("m1_warehouse")
}

model MasterDataItem {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  code      String    @unique
  name      String
  category  String
  uomId     String    @map("uom_id")
  itemType  String    @map("item_type")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  uom       MasterDataUom        @relation(fields: [uomId], references: [uuid])
  doDetails DeliveryOrderDetail[]

  @@map("m1_item")
}

model DeliveryOrder {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(cuid())
  reportNo             BigInt    @unique @default(autoincrement()) @map("report_no")
  doNumber             String    @map("do_number")
  doDate               DateTime  @db.Date @map("do_date")
  doReceivedDate       DateTime  @db.Date @map("do_received_date")
  customerId           String    @map("customer_id")
  destinationCityId    String?   @map("destination_city_id")
  stdLeadTimeDays      Int       @default(0) @map("std_lead_time_days")
  stdReturnDoDays      Int       @default(0) @map("std_return_do_days")
  shippingDate         DateTime? @db.Date @map("shipping_date")
  actualReceivedDate   DateTime? @db.Date @map("actual_received_date")
  receivedBy           String?   @map("received_by")
  doScanReturnDate     DateTime? @db.Date @map("do_scan_return_date")
  standardReceivedDate DateTime? @db.Date @map("standard_received_date")
  stdDoReturnDate      DateTime? @db.Date @map("std_do_return_date")
  kpiDeliveryStatus    String?   @map("kpi_delivery_status")
  kpiDoReturnStatus    String?   @map("kpi_do_return_status")
  totalItemTypes       Int       @default(0) @map("total_item_types")
  totalBatches         Int       @default(0) @map("total_batches")
  totalQtyPcs          Decimal   @default(0) @db.Decimal(18, 2) @map("total_qty_pcs")
  totalKg              Decimal   @default(0) @db.Decimal(18, 3) @map("total_kg")
  bu                   String?
  notes                String?
  status               String    @default("DRAFT")
  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            String?   @map("created_by")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy            String?   @map("updated_by")
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")

  customer        MasterDataContact @relation(fields: [customerId], references: [uuid])
  destinationCity MasterDataCity?   @relation("DoDestinationCity", fields: [destinationCityId], references: [uuid])
  details         DeliveryOrderDetail[]

  @@index([customerId])
  @@index([shippingDate])
  @@index([doReceivedDate])
  @@map("m2_do")
}

model DeliveryOrderDetail {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @default(cuid())
  doId             String    @map("do_id")
  lineNo           Int       @map("line_no")
  itemId           String    @map("item_id")
  batchNumber      String    @map("batch_number")
  qtyPcs           Decimal   @default(0) @db.Decimal(18, 2) @map("qty_pcs")
  qtyKg            Decimal   @db.Decimal(18, 3) @map("qty_kg")
  itemCodeSnapshot String?   @map("item_code_snapshot")
  itemNameSnapshot String?   @map("item_name_snapshot")
  uomCodeSnapshot  String?   @map("uom_code_snapshot")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  deliveryOrder DeliveryOrder @relation(fields: [doId], references: [uuid])
  item          MasterDataItem @relation(fields: [itemId], references: [uuid])

  @@unique([doId, lineNo])
  @@index([doId])
  @@index([itemId])
  @@map("m2_do_detail")
}

model Session {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  user User @relation(fields: [userId], references: [uuid])

  @@map("m0_session")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  userId     String?   @map("user_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  oldData    Json?     @map("old_data")
  newData    Json?     @map("new_data")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  user User? @relation(fields: [userId], references: [uuid])

  @@map("m0_auditlog")
}
