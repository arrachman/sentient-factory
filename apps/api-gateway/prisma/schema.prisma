// --- sys_* System Configuration ---

model ErpMenu {
  id          BigInt      @id @default(autoincrement())
  code        String      @unique @map("code")
  title       String      @map("title")
  path        String?     @map("path")
  icon        String?     @map("icon")
  type        ErpMenuType @map("type")
  parentId    BigInt?     @map("parent_id")
  sortOrder   Int         @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  legacyCode  String?     @map("legacy_code")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById BigInt?     @map("created_by_id")
  updatedById BigInt?     @map("updated_by_id")
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)

  parent     ErpMenu?               @relation("MenuParent", fields: [parentId], references: [id])
  children   ErpMenu[]              @relation("MenuParent")
