  managerUserId    Int?      @map("manager_user_id")
  title            String
  question         String?
  status           String
  insightCreatedAt DateTime  @map("insight_created_at") @db.Timestamptz(3)
  decisionAt       DateTime? @map("decision_at") @db.Timestamptz(3)
  decisionNote     String?   @map("decision_note")
