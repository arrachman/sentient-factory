  @@map("adm_user_roles")
}

model ErpRolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       ErpRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission ErpPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("adm_role_permissions")
}

model ErpRoleMenu {
  roleId     BigInt  @map("role_id")
