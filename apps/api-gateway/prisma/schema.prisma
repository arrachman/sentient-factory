generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id(map: "user_pkey") @default(autoincrement())
  uuid         String    @unique @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  warehouseId  String?   @map("warehouse_id")
  fullName     String?   @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  roles            UserRole[]
  departments      UserDepartment[]
  sessions         Session[]
  auditLogs        AuditLog[]
  warehouse        MasterDataWarehouse? @relation(fields: [warehouseId], references: [uuid])
  inventoryLedgers InventoryLedger[]

  @@index([warehouseId])
  @@map("m0_users")
}

model Role {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  permissions RolePermission[]
  users       UserRole[]
  menus       RoleMenu[]

  @@map("m0_role")
}

model Menu {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(cuid())
  key            String    @unique
  title          String
  path           String?
  icon           String?
  type           String    @default("ITEM")
  parentId       String?   @map("parent_id")
  sortOrder      Int       @default(0) @map("sort_order")
  isVisible      Boolean   @default(true) @map("is_visible")
  isActive       Boolean   @default(true) @map("is_active")
  permissionName String?   @map("permission_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  parent   Menu?      @relation("MenuHierarchy", fields: [parentId], references: [uuid])
  children Menu[]     @relation("MenuHierarchy")
  roles    RoleMenu[]

  @@index([parentId, sortOrder])
  @@map("m0_menu")
}

model RoleMenu {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  roleId     String    @map("role_id")
  menuId     String    @map("menu_id")
  canView    Boolean   @default(true) @map("can_view")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  role Role @relation(fields: [roleId], references: [uuid])
  menu Menu @relation(fields: [menuId], references: [uuid])

  @@unique([roleId, menuId])
  @@map("m0_role_menu")
}

model Permission {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String    @unique
  description String?
  module      String
  action      String
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  roles RolePermission[]

  @@map("m0_permission")
}

model RolePermission {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(cuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  role       Role       @relation(fields: [roleId], references: [uuid])
  permission Permission @relation(fields: [permissionId], references: [uuid])

  @@unique([roleId, permissionId])
  @@map("m0_role_permission")
}

model Department {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String
  code        String    @unique
  description String?
  parentId    String?   @map("parent_id")
  managerId   String?   @map("manager_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  parent   Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [uuid])
  children Department[]     @relation("DepartmentHierarchy")
  users    UserDepartment[]

  @@map("m0_department")
}

model UserRole {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  user User @relation(fields: [userId], references: [uuid])
  role Role @relation(fields: [roleId], references: [uuid])

  @@unique([userId, roleId])
  @@map("m0_user_role")
}

model UserDepartment {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(cuid())
  userId       String    @map("user_id")
  departmentId String    @map("department_id")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  user       User       @relation(fields: [userId], references: [uuid])
  department Department @relation(fields: [departmentId], references: [uuid])

  @@unique([userId, departmentId])
  @@map("m0_user_department")
}

model MasterDataContact {
  id               Int             @id @default(autoincrement())
  uuid             String          @unique @default(cuid())
  code             String          @unique
  name             String
  tax              String?
  website          String?
  address          String?
  street           String?
  city             String?
  province         String?
  zipCode          String?         @map("zip_code")
  type             String
  contactFirstName String?         @map("contact_first_name")
  contactEmail     String?         @map("contact_email")
  contactPhone     String?         @map("contact_phone")
  createdAt        DateTime        @default(now()) @map("created_at")
  createdBy        String?         @map("created_by")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?         @map("updated_by")
  deletedAt        DateTime?       @map("deleted_at")
  deletedBy        String?         @map("deleted_by")
  deliveryOrders   DeliveryOrder[]
  inbounds         Inbound[]       @relation("InboundSupplier")

  @@map("m1_contact")
}

model MasterDataUom {
  id               Int               @id @default(autoincrement())
  uuid             String            @unique @default(cuid())
  code             String            @unique
  name             String
  type             String
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")
  items            MasterDataItem[]
  inventoryLedgers InventoryLedger[]

  @@map("m1_uom")
}

model MasterDataDivision {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  @@map("m1_division")
}

model MasterDataProvince {
  id        Int              @id @default(autoincrement())
  uuid      String           @unique @default(cuid())
  name      String
  isoCode   String           @unique @map("iso_code")
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy String?          @map("created_by")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by")
  deletedAt DateTime?        @map("deleted_at")
  deletedBy String?          @map("deleted_by")
  cities    MasterDataCity[]

  @@map("m1_province")
}

model MasterDataCity {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  provinceId String    @map("province_id")
  name       String
  postalCode String    @map("postal_code")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  province       MasterDataProvince    @relation(fields: [provinceId], references: [uuid])
  warehouses     MasterDataWarehouse[]
  deliveryOrders DeliveryOrder[]       @relation("DoDestinationCity")
  citySlas       MasterDataCitySla[]

  @@map("m1_city")
}

model MasterDataCitySla {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(cuid())
  cityId          String    @map("city_id")
  stdLeadTimeDays Int       @default(0) @map("std_lead_time_days")
  stdReturnDoDays Int       @default(0) @map("std_return_do_days")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  city MasterDataCity @relation(fields: [cityId], references: [uuid])

  @@index([cityId])
  @@map("m1_city_sla")
}

model MasterDataWarehouse {
  id               Int               @id @default(autoincrement())
  uuid             String            @unique @default(cuid())
  name             String
  cityId           String            @map("city_id")
  locationName     String?           @map("location_name")
  addressDetail    String?           @map("address_detail")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")
  city             MasterDataCity    @relation(fields: [cityId], references: [uuid])
  inbounds         Inbound[]
  users            User[]
  inventoryLedgers InventoryLedger[]

  @@map("m1_warehouse")
}

model MasterDataItem {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  code      String    @unique
  name      String
  category  String
  uomId     String    @map("uom_id")
  itemType  String    @map("item_type")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  uom              MasterDataUom         @relation(fields: [uomId], references: [uuid])
  doDetails        DeliveryOrderDetail[]
  inboundDetails   InboundDetail[]
  inventoryBatches InventoryBatch[]
  inventoryLedgers InventoryLedger[]

  @@map("m1_item")
}

model DeliveryOrder {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(cuid())
  reportNo             BigInt    @unique @default(autoincrement()) @map("report_no")
  doNumber             String    @map("do_number")
  doDate               DateTime  @map("do_date") @db.Date
  doReceivedDate       DateTime  @map("do_received_date") @db.Date
  customerId           String    @map("customer_id")
  destinationCityId    String?   @map("destination_city_id")
  stdLeadTimeDays      Int       @default(0) @map("std_lead_time_days")
  stdReturnDoDays      Int       @default(0) @map("std_return_do_days")
  shippingDate         DateTime? @map("shipping_date") @db.Date
  actualReceivedDate   DateTime? @map("actual_received_date") @db.Date
  receivedBy           String?   @map("received_by")
  doScanReturnDate     DateTime? @map("do_scan_return_date") @db.Date
  standardReceivedDate DateTime? @map("standard_received_date") @db.Date
  stdDoReturnDate      DateTime? @map("std_do_return_date") @db.Date
  kpiDeliveryStatus    String?   @map("kpi_delivery_status")
  kpiDoReturnStatus    String?   @map("kpi_do_return_status")
  totalItemTypes       Int       @default(0) @map("total_item_types")
  totalBatches         Int       @default(0) @map("total_batches")
  totalQtyPcs          Decimal   @default(0) @map("total_qty_pcs") @db.Decimal(18, 2)
  totalKg              Decimal   @default(0) @map("total_kg") @db.Decimal(18, 3)
  bu                   String?
  notes                String?
  status               String    @default("DRAFT")
  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            String?   @map("created_by")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy            String?   @map("updated_by")
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")

  customer        MasterDataContact     @relation(fields: [customerId], references: [uuid])
  destinationCity MasterDataCity?       @relation("DoDestinationCity", fields: [destinationCityId], references: [uuid])
  details         DeliveryOrderDetail[]

  @@index([customerId])
  @@index([shippingDate])
  @@index([doReceivedDate])
  @@map("m2_outbound")
}

model DeliveryOrderDetail {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @default(cuid())
  doId             String    @map("do_id")
  lineNo           Int       @map("line_no")
  itemId           String    @map("item_id")
  qtyPcs           Decimal   @default(0) @map("qty_pcs") @db.Decimal(18, 2)
  qtyKg            Decimal   @map("qty_kg") @db.Decimal(18, 3)
  itemCodeSnapshot String?   @map("item_code_snapshot")
  itemNameSnapshot String?   @map("item_name_snapshot")
  uomCodeSnapshot  String?   @map("uom_code_snapshot")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  deliveryOrder DeliveryOrder         @relation(fields: [doId], references: [uuid])
  item          MasterDataItem        @relation(fields: [itemId], references: [uuid])
  batches       OutboundDetailBatch[]

  @@unique([doId, lineNo])
  @@index([doId])
  @@index([itemId])
  @@map("m2_outbound_detail")
}

model OutboundDetailBatch {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @default(cuid())
  outboundDetailId String    @map("outbound_detail_id")
  lineNo           Int       @map("line_no")
  batchOut         String    @map("batch_out")
  qtyPcs           Decimal   @default(0) @map("qty_pcs") @db.Decimal(18, 2)
  qtyKg            Decimal   @default(0) @map("qty_kg") @db.Decimal(18, 3)
  expiredDate      DateTime? @map("expired_date") @db.Date
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  outboundDetail DeliveryOrderDetail @relation(fields: [outboundDetailId], references: [uuid])

  @@unique([outboundDetailId, lineNo])
  @@index([outboundDetailId])
  @@map("m2_outbound_detail_batch")
}

model Inbound {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(cuid())
  reportNo        BigInt    @unique @default(autoincrement()) @map("report_no")
  transactionNo   String    @unique @map("transaction_no")
  transactionDate DateTime  @default(now()) @map("transaction_date") @db.Date
  supplierId      String    @map("supplier_id")
  warehouseId     String    @map("warehouse_id")
  notes           String?
  status          String    @default("DRAFT")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  supplier  MasterDataContact   @relation("InboundSupplier", fields: [supplierId], references: [uuid])
  warehouse MasterDataWarehouse @relation(fields: [warehouseId], references: [uuid])
  details   InboundDetail[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([transactionDate])
  @@map("m2_inbound")
}

model InboundDetail {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @default(cuid())
  inboundId        String    @map("inbound_id")
  lineNo           Int       @map("line_no")
  itemId           String    @map("item_id")
  qty              Decimal   @default(0) @db.Decimal(18, 2)
  uomInput         Int?      @map("uom_input")
  itemCodeSnapshot String?   @map("item_code_snapshot")
  itemNameSnapshot String?   @map("item_name_snapshot")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  inbound Inbound              @relation(fields: [inboundId], references: [uuid])
  item    MasterDataItem       @relation(fields: [itemId], references: [uuid])
  batches InboundDetailBatch[]

  @@unique([inboundId, lineNo])
  @@index([inboundId])
  @@index([itemId])
  @@map("m2_inbound_detail")
}

model InboundDetailBatch {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(cuid())
  inboundDetailId String    @map("inbound_detail_id")
  lineNo          Int       @map("line_no")
  batchIn         String    @map("batch_in")
  qty             Decimal   @default(0) @db.Decimal(18, 2)
  expiredDate     DateTime? @map("expired_date") @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  inboundDetail InboundDetail @relation(fields: [inboundDetailId], references: [uuid])

  @@unique([inboundDetailId, lineNo])
  @@index([inboundDetailId])
  @@map("m2_inbound_detail_batch")
}

model InventoryBatch {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(cuid())
  itemId            String    @map("item_id")
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  supplierLotNumber String?   @map("supplier_lot_number")
  notes             String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")

  item   MasterDataItem    @relation(fields: [itemId], references: [uuid])
  ledger InventoryLedger[]

  @@unique([itemId, batchNumber])
  @@index([itemId])
  @@index([expiryDate])
  @@map("m2_inventory_batch")
}

model InventoryLedger {
  id               BigInt    @id @default(autoincrement())
  uuid             String    @unique @default(cuid())
  transactionDate  DateTime  @default(now()) @map("transaction_date")
  itemId           String    @map("item_id")
  warehouseId      String    @map("warehouse_id")
  batchId          String    @map("batch_id")
  transactionType  String    @map("transaction_type")
  referenceDocType String?   @map("reference_doc_type")
  referenceDocId   String?   @map("reference_doc_id")
  referenceNumber  String?   @map("reference_number")
  quantityPcs      Decimal   @default(0) @map("quantity_pcs") @db.Decimal(18, 2)
  quantityKg       Decimal   @default(0) @map("quantity_kg") @db.Decimal(18, 3)
  uomId            String    @map("uom_id")
  unitCost         Decimal?  @map("unit_cost") @db.Decimal(15, 2)
  totalValue       Decimal   @default(0) @map("total_value") @db.Decimal(18, 2)
  userId           String?   @map("user_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  item      MasterDataItem      @relation(fields: [itemId], references: [uuid])
  warehouse MasterDataWarehouse @relation(fields: [warehouseId], references: [uuid])
  batch     InventoryBatch      @relation(fields: [batchId], references: [uuid])
  uom       MasterDataUom       @relation(fields: [uomId], references: [uuid])
  user      User?               @relation(fields: [userId], references: [uuid])

  @@index([itemId, warehouseId, batchId])
  @@index([itemId, warehouseId, batchId, transactionDate])
  @@index([transactionDate])
  @@index([referenceDocType, referenceDocId])
  @@index([batchId])
  @@map("m2_inventory_ledger")
}

model Session {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  user User @relation(fields: [userId], references: [uuid])

  @@map("m0_session")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(cuid())
  userId     String?   @map("user_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  oldData    Json?     @map("old_data")
  newData    Json?     @map("new_data")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  user User? @relation(fields: [userId], references: [uuid])

  @@map("m0_auditlog")
}
