}

model ErpCurrency {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @map("code")
  name        String    @map("name")
  symbol      String?   @map("symbol")
  isActive    Boolean   @default(true) @map("is_active")
  legacyCode  String?   @map("legacy_code")
