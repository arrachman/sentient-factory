  createdById   BigInt?   @map("created_by_id")
  updatedById   BigInt?   @map("updated_by_id")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  partner ErpPartner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
