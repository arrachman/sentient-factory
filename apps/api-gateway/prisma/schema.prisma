  discountDays2    Int?      @map("discount_days2")
  penaltyPercent   Decimal?  @map("penalty_percent") @db.Decimal(9, 4)
  penaltyPeriod    String?   @map("penalty_period")
  isActive         Boolean   @default(true) @map("is_active")
  legacyCode       String?   @map("legacy_code")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      BigInt?   @map("created_by_id")
  updatedById      BigInt?   @map("updated_by_id")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

