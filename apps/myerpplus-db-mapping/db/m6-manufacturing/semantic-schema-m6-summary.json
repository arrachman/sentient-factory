        {
          "name": "bom_structure_flow",
          "description": "Relationship from the BOM header to input and output components.",
          "joins": [
            "m6_bom.bomid = m6_bom_in.idbom",
            "m6_bom.bomid = m6_bom_out.idbom"
          ]
        },
        {
          "name": "mrs_to_mrn_flow",
          "description": "Relationship from material request slips to material receipt notes.",
          "joins": [
            "m6_mrs.mrsid = m6_mrs_out.idmrs",
            "m6_mrs_out.idmrsout = m6_mrn_out.idmrsout",
            "m6_mrn.mrnid = m6_mrn_out.idmrn"
          ]
        },
        {
          "name": "mrs_to_pd_flow",
          "description": "Relationship from material request slips to production documents.",
          "joins": [
            "m6_mrs.mrsid = m6_mrs_out.idmrs",
            "m6_mrs_out.idmrsout = m6_pd_out.idmrsout",
            "m6_pd.pdid = m6_pd_out.idpd"
          ]
        },
        {
          "name": "workorder_material_output_flow",
          "description": "Relationship from work orders to input, output, activity, and route-card details.",
          "joins": [
            "m6_wo.woid = m6_wo_in.idwo",
            "m6_wo.woid = m6_wo_out.idwo",
            "m6_wo.woid = m6_wo_activity.idwo",
            "m6_wo.woid = m6_wo_route_card.idwo"
          ]
        }
      ],
