{
  "domain": "obt",
  "description": "Schema query read-only untuk analitik dan tanya-jawab domain OBT berdasarkan semantic-schema m5.",
  "default_rules": {
    "read_only": true,
    "sql_dialect": "mysql",
    "use_header_detail_join_for_amounts": true,
    "prefer_detail_table_for_qty_and_item_analysis": true,
    "default_date_dimension": "tanggal_transaksi",
    "notes": [
      "Gunakan filter isclose = 0 sesuai always_apply_filters pada semantic schema jika tersedia.",
      "Untuk analitik nilai penjualan per item, gunakan m5_si_detail sebagai basis lalu join ke m5_si.",
      "Untuk analitik order penjualan, gunakan m5_so_detail sebagai basis lalu join ke m5_so.",
      "Untuk analitik customer, join ke m1_contact melalui field customer pada header transaksi."
    ]
  },
  "entities": [
    {
      "name": "customer",
      "base_table": "m1_contact",
      "alias": "c",
      "grain": "satu baris per kontak/customer",
      "recommended_filters": [
        "kaktif = 1 jika hanya ingin customer aktif"
      ],
      "fields": {
        "customer_id": "c.kid",
        "customer_kode": "c.kkode",
        "customer_nama": "c.knama",
        "customer_kategori": "c.kkategoricustomer",
        "customer_kategori_nama": "c.kkategoricustomernama",
        "customer_kota": "c.kkota",
        "customer_sales": "c.kbagpenjualan",
        "batas_piutang": "c.kbataspiutang",
        "termin_jual": "c.kterminjual",
        "total_piutang": "c.ktotalpiutang"
      }
    },
    {
      "name": "penawaran_penjualan",
      "base_table": "m5_sq",
      "alias": "sq",
      "grain": "satu baris per header quotation/penawaran",
      "default_filter": "sq.sqisclose = 0",
      "joins": [
        "LEFT JOIN m1_contact c ON sq.sqcustomer = c.kid"
      ],
      "fields": {
        "quotation_id": "sq.sqid",
        "nomor_penawaran": "sq.sqnotransaksi",
        "tanggal_transaksi": "sq.sqtgl",
        "customer_id": "sq.sqcustomer",
        "customer_nama": "c.knama",
        "cabang": "sq.sqcabang",
        "lokasi": "sq.sqlokasi",
        "sales": "sq.sqbagianpenjualan",
        "status": "sq.sqstatus",
        "status_so": "sq.sqstatusso",
        "total_transaksi": "sq.sqtotaltransaksi",
        "mata_uang": "sq.sqmatauang",
        "kurs": "sq.sqkurs"
      }
    },
    {
      "name": "order_penjualan",
      "base_table": "m5_so",
      "alias": "so",
      "grain": "satu baris per header sales order",
      "default_filter": "so.soisclose = 0",
      "joins": [
        "LEFT JOIN m1_contact c ON so.socustomer = c.kid"
      ],
      "fields": {
        "so_id": "so.soid",
        "nomor_so": "so.sonotransaksi",
        "tanggal_transaksi": "so.sotgl",
        "tanggal_kirim": "so.sotglkirim",
        "tanggal_jatuh_tempo": "so.sotgljatuhtempo",
        "customer_id": "so.socustomer",
        "customer_nama": "c.knama",
        "cabang": "so.socabang",
        "lokasi": "so.solokasi",
        "gudang": "so.sogudang",
        "jenis_penjualan": "so.sojenispenjualan",
        "sales": "so.sobagianpenjualan",
        "ekspedisi": "so.soekspedisi",
        "status": "so.sostatus",
        "status_do": "so.sostatusdo",
        "status_si": "so.sostatussi",
        "status_realisasi": "so.sostatusrealisasi",
        "subtotal": "so.sototal",
        "diskon": "so.sojmldiskon",
        "pajak_1": "so.sototalpajak1detail",
        "pajak_2": "so.sototalpajak2detail",
        "biaya_lain": "so.sobiayalain",
        "total_transaksi": "so.sototaltransaksi",
        "mata_uang": "so.somatauang",
        "kurs": "so.sokurs"
      },
      "metrics": {
        "jumlah_so": "COUNT(DISTINCT so.soid)",
        "nilai_so": "SUM(so.sototaltransaksi)"
      }
    },
    {
      "name": "order_penjualan_detail",
      "base_table": "m5_so_detail",
      "alias": "sod",
      "grain": "satu baris per item sales order",
      "default_filter": "sod.isclose = 0",
      "joins": [
        "INNER JOIN m5_so so ON sod.idso = so.soid AND so.soisclose = 0",
        "LEFT JOIN m1_contact c ON so.socustomer = c.kid",
        "LEFT JOIN m1_item i ON sod.idbarang = i.bid"
      ],
      "fields": {
        "so_detail_id": "sod.idsodetail",
        "so_id": "sod.idso",
        "nomor_so": "so.sonotransaksi",
        "tanggal_transaksi": "so.sotgl",
        "customer_id": "so.socustomer",
        "customer_nama": "c.knama",
        "barang_id": "sod.idbarang",
        "nama_barang": "sod.namabarang",
        "qty": "sod.jmlbarang",
        "satuan": "sod.satuanbarang",
        "harga": "sod.harga",
        "diskon": "sod.jmldiskon",
        "pajak_1": "sod.jmlpajak1",
        "pajak_2": "sod.jmlpajak2",
        "status_do": "sod.statusdo",
        "status_si": "sod.statussi",
        "qty_realisasi": "sod.jmlrealisasi"
      },
      "metrics": {
        "total_qty_order": "SUM(sod.jmlbarang)",
        "total_nilai_so": "SUM((sod.jmlbarang * sod.harga) - sod.jmldiskon + sod.jmlpajak1 + sod.jmlpajak2)",
        "avg_harga_so": "AVG(sod.harga)"
      }
    },
    {
      "name": "pengiriman_penjualan",
      "base_table": "m5_do",
      "alias": "doj",
      "grain": "satu baris per header delivery order/surat jalan",
      "default_filter": "doj.doisclose = 0",
      "joins": [
        "LEFT JOIN m1_contact c ON doj.docustomer = c.kid"
      ],
      "fields": {
        "do_id": "doj.doid",
        "nomor_do": "doj.donotransaksi",
        "tanggal_transaksi": "doj.dotgl",
        "tanggal_kirim": "doj.dotglkirim",
        "customer_id": "doj.docustomer",
        "customer_nama": "c.knama",
        "gudang": "doj.dogudang",
        "sales": "doj.dobagianpenjualan",
        "bagian_pengiriman": "doj.dobagianpengiriman",
        "ekspedisi": "doj.doekspedisi",
        "status": "doj.dostatus",
        "status_si": "doj.dostatussi",
        "status_realisasi": "doj.dostatusrealisasi",
        "total_transaksi": "doj.dototaltransaksi"
      },
      "metrics": {
        "jumlah_do": "COUNT(DISTINCT doj.doid)",
        "nilai_do": "SUM(doj.dototaltransaksi)"
      }
    },
    {
      "name": "invoice_penjualan",
      "base_table": "m5_si",
      "alias": "si",
      "grain": "satu baris per header invoice penjualan",
      "default_filter": "si.siisclose = 0",
      "joins": [
        "LEFT JOIN m1_contact c ON si.sicustomer = c.kid"
      ],
      "fields": {
        "invoice_id": "si.siid",
        "nomor_invoice": "si.sinotransaksi",
        "tanggal_transaksi": "si.sitgl",
        "tanggal_kirim": "si.sitglkirim",
        "tanggal_jatuh_tempo": "si.sitgljatuhtempo",
        "tanggal_lunas": "si.sitgllunas",
        "customer_id": "si.sicustomer",
        "customer_nama": "c.knama",
        "cabang": "si.sicabang",
        "lokasi": "si.silokasi",
        "gudang": "si.sigudang",
        "jenis_penjualan": "si.sijenispenjualan",
        "sales": "si.sibagianpenjualan",
        "status": "si.sistatus",
        "status_lunas": "si.sistatuslunas",
        "status_realisasi": "si.sistatusrealisasi",
        "subtotal": "si.sitotal",
        "diskon": "si.sijmldiskon",
        "pajak_1": "si.sitotalpajak1detail",
        "pajak_2": "si.sitotalpajak2detail",
        "biaya_lain": "si.sibiayalain",
        "uang_muka": "si.sijmluangmuka",
        "jumlah_bayar": "si.sijmlbayar",
        "total_transaksi": "si.sitotaltransaksi",
        "mata_uang": "si.simatauang",
        "kurs": "si.sikurs",
        "id_so": "si.siidso",
        "id_do": "si.siiddo"
      },
      "metrics": {
        "jumlah_invoice": "COUNT(DISTINCT si.siid)",
        "nilai_invoice": "SUM(si.sitotaltransaksi)",
        "nilai_terbayar": "SUM(si.sijmlbayar)",
        "invoice_belum_lunas": "SUM(CASE WHEN COALESCE(si.sistatuslunas, '') NOT IN ('LUNAS', 'Lunas', 'lunas') THEN si.sitotaltransaksi ELSE 0 END)"
      }
    },
    {
      "name": "invoice_penjualan_detail",
      "base_table": "m5_si_detail",
      "alias": "sid",
      "grain": "satu baris per item invoice penjualan",
      "default_filter": "sid.isclose = 0",
      "joins": [
        "INNER JOIN m5_si si ON sid.idsi = si.siid AND si.siisclose = 0",
        "LEFT JOIN m1_contact c ON si.sicustomer = c.kid",
        "LEFT JOIN m1_item i ON sid.idbarang = i.bid"
      ],
      "fields": {
        "invoice_detail_id": "sid.idsidetail",
        "invoice_id": "sid.idsi",
        "nomor_invoice": "si.sinotransaksi",
        "tanggal_transaksi": "si.sitgl",
        "customer_id": "si.sicustomer",
        "customer_nama": "c.knama",
        "barang_id": "sid.idbarang",
        "nama_barang": "sid.namabarang",
        "qty": "sid.jmlbarang",
        "satuan": "sid.satuanbarang",
        "harga": "sid.harga",
        "hpp": "sid.hpp",
        "diskon": "sid.jmldiskon",
        "pajak_1": "sid.jmlpajak1",
        "pajak_2": "sid.jmlpajak2",
        "qty_realisasi": "sid.jmlrealisasi",
        "status_realisasi": "sid.statusrealisasi",
        "is_bonus": "sid.isbonus"
      },
      "metrics": {
        "total_qty_invoice": "SUM(sid.jmlbarang)",
        "total_penjualan_kotor": "SUM(sid.jmlbarang * sid.harga)",
        "total_diskon": "SUM(sid.jmldiskon)",
        "total_pajak": "SUM(sid.jmlpajak1 + sid.jmlpajak2)",
        "total_penjualan_bersih": "SUM((sid.jmlbarang * sid.harga) - sid.jmldiskon + sid.jmlpajak1 + sid.jmlpajak2)",
        "total_hpp": "SUM(sid.jmlbarang * sid.hpp)",
        "estimasi_laba_kotor": "SUM(((sid.jmlbarang * sid.harga) - sid.jmldiskon) - (sid.jmlbarang * sid.hpp))"
      }
    },
    {
      "name": "retur_penjualan",
      "base_table": "m5_sr",
      "alias": "sr",
      "grain": "satu baris per header retur penjualan",
      "default_filter": "sr.srisclose = 0",
      "joins": [
        "LEFT JOIN m1_contact c ON sr.srcustomer = c.kid"
      ],
      "fields": {
        "retur_id": "sr.srid",
        "nomor_retur": "sr.srnotransaksi",
        "tanggal_transaksi": "sr.srtgl",
        "customer_id": "sr.srcustomer",
        "customer_nama": "c.knama",
        "sales": "sr.srbagianpenjualan",
        "status": "sr.srstatus",
        "status_lunas": "sr.srstatuslunas",
        "total_transaksi": "sr.srtotaltransaksi",
        "jumlah_bayar": "sr.srjmlbayar",
        "sisa_transaksi": "sr.srsisatransaksi"
      },
      "metrics": {
        "jumlah_retur": "COUNT(DISTINCT sr.srid)",
        "nilai_retur": "SUM(sr.srtotaltransaksi)"
      }
    },
    {
      "name": "pelunasan_piutang",
      "base_table": "m5_pv",
      "alias": "pv",
      "grain": "satu baris per header pembayaran piutang customer",
      "default_filter": "pv.pvisclose = 0",
      "joins": [
        "LEFT JOIN m1_contact c ON pv.pvcustomer = c.kid"
      ],
      "fields": {
        "pelunasan_id": "pv.pvid",
        "nomor_pelunasan": "pv.pvnotransaksi",
        "tanggal_transaksi": "pv.pvtgl",
        "customer_id": "pv.pvcustomer",
        "customer_nama": "c.knama",
        "sales": "pv.pvbagianpenjualan",
        "status": "pv.pvstatus",
        "jumlah_bayar": "pv.pvjmlbayar",
        "jumlah_transaksi": "pv.pvtotaltransaksi",
        "mata_uang": "pv.pvmatauang",
        "kurs": "pv.pvkurs"
      },
      "metrics": {
        "jumlah_pelunasan": "COUNT(DISTINCT pv.pvid)",
        "total_pelunasan": "SUM(pv.pvjmlbayar)"
      }
    }
  ],
  "common_dimensions": {
    "waktu": [
      "DATE(tanggal_transaksi)",
      "YEAR(tanggal_transaksi)",
      "MONTH(tanggal_transaksi)",
      "DATE_FORMAT(tanggal_transaksi, '%Y-%m')"
    ],
    "organisasi": [
      "cabang",
      "lokasi",
      "gudang",
      "sales"
    ],
    "customer": [
      "customer_id",
      "customer_nama",
      "customer_kategori"
    ],
    "produk": [
      "barang_id",
      "nama_barang",
      "satuan"
    ],
    "status": [
      "status",
      "status_lunas",
      "status_realisasi",
      "status_do",
      "status_si"
    ]
  },
  "query_templates": [
    {
      "name": "tren_penjualan_bulanan",
      "description": "Nilai invoice penjualan per bulan.",
      "base_entity": "invoice_penjualan",
      "sql": "SELECT DATE_FORMAT(si.sitgl, '%Y-%m') AS bulan, SUM(si.sitotaltransaksi) AS nilai_penjualan FROM m5_si si WHERE si.siisclose = 0 GROUP BY DATE_FORMAT(si.sitgl, '%Y-%m') ORDER BY bulan;"
    },
    {
      "name": "top_customer_penjualan",
      "description": "Customer dengan nilai invoice terbesar.",
      "base_entity": "invoice_penjualan",
      "sql": "SELECT si.sicustomer AS customer_id, c.knama AS customer_nama, SUM(si.sitotaltransaksi) AS nilai_penjualan FROM m5_si si LEFT JOIN m1_contact c ON si.sicustomer = c.kid WHERE si.siisclose = 0 GROUP BY si.sicustomer, c.knama ORDER BY nilai_penjualan DESC LIMIT 10;"
    },
    {
      "name": "top_barang_terjual",
      "description": "Barang dengan qty invoice tertinggi.",
      "base_entity": "invoice_penjualan_detail",
      "sql": "SELECT sid.idbarang AS barang_id, sid.namabarang AS nama_barang, SUM(sid.jmlbarang) AS total_qty, SUM((sid.jmlbarang * sid.harga) - sid.jmldiskon + sid.jmlpajak1 + sid.jmlpajak2) AS nilai_bersih FROM m5_si_detail sid INNER JOIN m5_si si ON sid.idsi = si.siid WHERE sid.isclose = 0 AND si.siisclose = 0 GROUP BY sid.idbarang, sid.namabarang ORDER BY total_qty DESC LIMIT 10;"
    },
    {
      "name": "outstanding_invoice_customer",
      "description": "Invoice belum lunas per customer.",
      "base_entity": "invoice_penjualan",
      "sql": "SELECT si.sicustomer AS customer_id, c.knama AS customer_nama, COUNT(*) AS jumlah_invoice, SUM(si.sitotaltransaksi - COALESCE(si.sijmlbayar, 0)) AS outstanding FROM m5_si si LEFT JOIN m1_contact c ON si.sicustomer = c.kid WHERE si.siisclose = 0 AND (si.sitotaltransaksi - COALESCE(si.sijmlbayar, 0)) > 0 GROUP BY si.sicustomer, c.knama ORDER BY outstanding DESC;"
    },
    {
      "name": "konversi_so_ke_invoice",
      "description": "Perbandingan nilai sales order dan invoice berdasarkan referensi SO.",
      "base_entity": "invoice_penjualan",
      "sql": "SELECT so.soid AS so_id, so.sonotransaksi AS nomor_so, so.sototaltransaksi AS nilai_so, SUM(si.sitotaltransaksi) AS nilai_invoice FROM m5_so so LEFT JOIN m5_si si ON si.siidso = so.soid AND si.siisclose = 0 WHERE so.soisclose = 0 GROUP BY so.soid, so.sonotransaksi, so.sototaltransaksi ORDER BY so.sotgl DESC;"
    },
    {
      "name": "retur_penjualan_bulanan",
      "description": "Nilai retur penjualan per bulan.",
      "base_entity": "retur_penjualan",
      "sql": "SELECT DATE_FORMAT(sr.srtgl, '%Y-%m') AS bulan, SUM(sr.srtotaltransaksi) AS nilai_retur FROM m5_sr sr WHERE sr.srisclose = 0 GROUP BY DATE_FORMAT(sr.srtgl, '%Y-%m') ORDER BY bulan;"
    }
  ]
}
