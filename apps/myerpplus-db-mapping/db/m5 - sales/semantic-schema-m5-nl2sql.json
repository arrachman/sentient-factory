  "join_hints": [
    {
      "name": "sales_document_flow",
      "description": "Alur utama dokumen penjualan dari quotation sampai return.",
      "joins": [
        "m5_sq.sqid = m5_sq_detail.idsq",
        "m5_sq_detail.idsqdetail = m5_so_detail.idsqdetail",
        "m5_so.soid = m5_so_detail.idso",
        "m5_so_detail.idsodetail = m5_pl_detail.idsodetail",
        "m5_pl.plid = m5_pl_detail.idpl",
        "m5_so_detail.idsodetail = m5_do_detail.idsodetail",
        "m5_do.doid = m5_do_detail.iddo",
        "m5_do_detail.iddodetail = m5_dr_detail.iddodetail",
        "m5_pi.piid = m5_pi_detail.idpi",
        "m5_si.siid = m5_si_detail.idsi",
        "m5_rnr.rnrid = m5_rnr_detail.idrnr",
        "m5_sr.srid = m5_sr_detail.idsr"
      ]
    },
    {
      "name": "sales_document_cross_refs",
      "description": "Relasi silang detail antar dokumen penjualan untuk tracing progres dokumen.",
      "joins": [
        "m5_pi_detail.idsqdetail = m5_sq_detail.idsqdetail",
        "m5_pi_detail.idsodetail = m5_so_detail.idsodetail",
        "m5_pi_detail.idpldetail = m5_pl_detail.idpldetail",
        "m5_pl_detail.idpidetail = m5_pi_detail.idpidetail",
        "m5_do_detail.idpidetail = m5_pi_detail.idpidetail",
        "m5_dr_detail.idpidetail = m5_pi_detail.idpidetail",
        "m5_rnr_detail.idsidetail = m5_si_detail.idsidetail",
        "m5_sr_detail.idsidetail = m5_si_detail.idsidetail",
        "m5_sr_detail.idrnrdetail = m5_rnr_detail.idrnrdetail"
      ]
    },
    {
      "name": "sales_receivable_collection",
      "description": "Alur penagihan dan pembayaran piutang penjualan.",
      "joins": [
        "m5_ic.icid = m5_ic_detail.idic",
        "m5_pv.pvid = m5_pv_detail.idpv",
        "m5_pv_detail.idicdetail = m5_ic_detail.idicdetail"
      ]
    },
    {
      "name": "sales_invoice_exchange",
      "description": "Relasi tukar faktur penjualan terhadap dokumen sumber invoice dan return.",
      "joins": [
        "m5_sie.sieid = m5_sie_detail.idsie",
        "m5_sie_detail.sumber = m5_si.sisumber AND m5_sie_detail.idtransaksi = m5_si.siid",
        "m5_sie_detail.sumber = m5_sr.srsumber AND m5_sie_detail.idtransaksi = m5_sr.srid"
      ]
    },
    {
      "name": "sales_advance_and_payment",
      "description": "Relasi uang muka, penerimaan pembayaran, dan invoice terkait.",
      "joins": [
        "m5_as.asid = m5_as_pay.idas",
        "m5_ip.ipid = m5_ip_pay.idip",
        "m5_as.asidip = m5_ip.ipid",
        "m5_si.siidas = m5_as.asid"
      ]
    },
    {
      "name": "sales_shipping_receivable",
      "description": "Relasi piutang ongkos kirim dengan invoice penjualan dan detail pembayarannya.",
      "joins": [
        "m5_rp.rpid = m5_rp_pay.idrp",
        "m5_rp.rpidsi = m5_si.siid"
      ]
    }
  ],
  "polymorphic_relationships": [
    {
      "table_name": "m5_ic_detail",
      "id_column": "idtransaksi",
      "discriminator_column": "sumber",
      "description": "Relasi polymorphic ke dokumen yang ditagih dalam invoice collection.",
      "mappings": [
        {
          "source_value": "AS",
          "target_table": "m5_as",
          "target_column": "asid"
        },
        {
          "source_value": "SI",
          "target_table": "m5_si",
          "target_column": "siid"
        },
        {
          "source_value": "SR",
          "target_table": "m5_sr",
          "target_column": "srid"
        }
      ]
    },
    {
      "table_name": "m5_pv_detail",
      "id_column": "idtransaksi",
      "discriminator_column": "sumber",
      "description": "Relasi polymorphic ke dokumen yang dibayar melalui payment voucher.",
      "mappings": [
        {
          "source_value": "SI",
          "target_table": "m5_si",
          "target_column": "siid"
        },
        {
          "source_value": "SR",
          "target_table": "m5_sr",
          "target_column": "srid"
        }
      ]
    },
    {
      "table_name": "m5_sie_detail",
      "id_column": "idtransaksi",
      "discriminator_column": "sumber",
      "description": "Relasi polymorphic ke dokumen sumber yang ikut dalam tukar faktur penjualan.",
      "mappings": [
        {
          "source_value": "SI",
          "target_table": "m5_si",
          "target_column": "siid"
        },
        {
          "source_value": "SR",
          "target_table": "m5_sr",
          "target_column": "srid"
        }
      ]
    }
  ],
  "important_rules": [
    "Gunakan tabel header untuk nomor dokumen, tanggal, customer, status, dan total transaksi.",
    "Gunakan tabel detail untuk item, kuantitas, harga, diskon, gudang, dan progres realisasi.",
    "Jangan join kolom idtransaksi pada m5_ic_detail, m5_pv_detail, atau m5_sie_detail tanpa memeriksa kolom sumber.",
    "Kolom carabayar berarti metode pembayaran, bukan nominal.",
    "Kolom customtext, customint, customdbl, customdate adalah field tambahan dan sebaiknya dihindari kecuali diminta eksplisit.",
    "Kolom kodepa adalah referensi internal PA dan tidak boleh diasumsikan sebagai foreign key pasti.",
    "Gunakan tabel history hanya jika pertanyaan memang meminta histori, audit trail, atau perubahan dokumen."
  ],
  "query_patterns": {
    "summary": [
      "Gunakan header table saja."
    ],
    "items_per_document": [
      "Join header ke detail dengan foreign key utama idheader."
    ],
    "document_tracing": [
      "Mulai dari detail table dan ikuti join_hints sales_document_flow atau sales_document_cross_refs."
    ],
    "receivable_collection": [
      "Gunakan IC -> IC_DETAIL -> PV_DETAIL -> PV."
    ],
    "invoice_return_chain": [
      "Gunakan SI -> SI_DETAIL -> RNR_DETAIL -> SR_DETAIL."
    ]
  },
  "caution_areas": [
    "Pertanyaan lintas SI, SR, AS melalui m5_ic_detail.",
    "Pertanyaan pembayaran yang memakai m5_pv_detail.idtransaksi.",
    "Pertanyaan tukar faktur yang memakai m5_sie_detail.idtransaksi.",
    "Pertanyaan histori yang mencampur tabel aktif dan history.",
    "Pertanyaan yang sangat bergantung pada field custom."
  ]
}
