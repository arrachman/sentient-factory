# =====================================================================
# web-althea — Environment variables
# Copy ke .env.local untuk development. Jangan commit .env.local.
# =====================================================================

# Port aplikasi (default 3202, lihat config/ports.json)
WEB_ALTHEA_PORT=3202

# API gateway URL (backend). WAJIB include `/api` global prefix dari NestJS.
# Dev: localhost:3203/api. Prod: althea.fr-labs.my.id/api.
NEXT_PUBLIC_API_URL=http://localhost:3203/api

# Public app URL (untuk redirects, cookie domain, dll)
NEXT_PUBLIC_APP_URL=http://localhost:3202

# Optional: tambah origin yang diizinkan untuk dev (comma-separated)
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.10,my-tunnel.example.com

# Optional: base path kalau di-deploy di subpath (e.g. /althea)
# NEXT_PUBLIC_BASE_PATH=/althea

# =====================================================================
# Production (lihat .env.production atau .planning/ADRs/009)
# =====================================================================
# Domain mapping (single subdomain, path-based split):
#   http://althea.fr-labs.my.id/        → web-althea (this app)
#   http://althea.fr-labs.my.id/api/*   → api-gateway
#
# Production env contoh:
#   NEXT_PUBLIC_APP_URL=http://althea.fr-labs.my.id
#   NEXT_PUBLIC_API_URL=http://althea.fr-labs.my.id/api
#   NEXT_ALLOWED_DEV_ORIGINS=althea.fr-labs.my.id
