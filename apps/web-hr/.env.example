# =====================================================================
# web-hr — Senti HR — Environment variables
# Copy ke .env.local untuk development. Jangan commit .env.local.
# =====================================================================

# Port aplikasi (default 3221, lihat config/ports.json → apps.web-hr)
WEB_HR_PORT=3221

# Internal api-gateway URL (server-side only, dipakai Next rewrite /api/* → gateway).
# Browser memanggil same-origin /api/* (auth + /api/hr/*) yang di-proxy ke sini.
HR_INTERNAL_API_URL=http://localhost:3203

# Optional: override base URL HTTP client di browser (default same-origin '/api').
# NEXT_PUBLIC_HR_API_URL=/api

# Public app URL (untuk redirects, cookie domain, dll)
NEXT_PUBLIC_APP_URL=http://localhost:3221

# Optional: tambah origin yang diizinkan untuk dev (comma-separated)
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.10,my-tunnel.example.com

# Optional: base path kalau di-deploy di subpath (e.g. /hr)
# NEXT_PUBLIC_BASE_PATH=/hr
