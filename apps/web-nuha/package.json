{
  "name": "@sentient-factory/web-nuha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev apps/web -p ${NUHA_WEB_PORT:-3226}",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build apps/web",
    "build:api": "npm --prefix apps/api run build",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "start": "npm --prefix apps/api run start:prod",
    "test": "npm --prefix apps/api test",
    "format": "prettier --write apps *.md"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.0",
    "next": "^15.5.0",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0"
  }
}
