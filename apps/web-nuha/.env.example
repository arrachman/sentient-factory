# Nuha SIMTERPADU — contoh env. Salin ke .env dan sesuaikan.
WEB_NUHA_PORT=3226

NUHA_MYSQL_PORT=3308
NUHA_MYSQL_DATABASE=nuha_simterpadu
NUHA_MYSQL_USER=nuha
NUHA_MYSQL_PASSWORD=change_me
NUHA_MYSQL_ROOT_PASSWORD=change_me

# Dipakai Prisma dari host (port yang dipublish compose)
DATABASE_URL="mysql://nuha:change_me@127.0.0.1:3308/nuha_simterpadu"

# Rahasia JWT sesi — WAJIB diganti di produksi (min 32 karakter)
AUTH_SECRET="dev-secret-change-me-in-production-32b"
