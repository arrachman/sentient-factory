// SIMTERPADU — Sistem Informasi Manajemen Terpadu
// Yayasan Pendidikan Islam Nurul Huda Mergosono
//
// Prinsip inti: SATU IDENTITAS, BANYAK PERAN.
// Seorang santri pondok yang juga siswa SMP adalah satu record `Orang`
// dengan beberapa baris peran (Santri, Siswa, Pegawai, Wali), bukan
// beberapa record terpisah per unit.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identitas & akses
// ─────────────────────────────────────────────────────────────

enum JenisKelamin {
  L
  P
}

model Orang {
  id        BigInt       @id @default(autoincrement())
  nik       String?      @unique @db.VarChar(32)
  nama      String       @db.VarChar(160)
  jk        JenisKelamin
  tglLahir  DateTime?    @map("tgl_lahir") @db.Date
  tmpLahir  String?      @map("tmp_lahir") @db.VarChar(120)
  alamat    String?      @db.VarChar(255)
  hp        String?      @db.VarChar(32)
  email     String?      @unique @db.VarChar(160)
  fotoUrl   String?      @map("foto_url") @db.VarChar(255)
  aktif     Boolean      @default(true)
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user        User?
  santri      Santri?
  pegawai     Pegawai?
  waliDari    RelasiWali[] @relation("WaliOrang")
  sebagaiAnak RelasiWali[] @relation("AnakOrang")

  @@index([nama])
  @@map("orang")
}

model Peran {
  id        Int     @id @default(autoincrement())
  key       String  @unique @db.VarChar(32)
  nama      String  @db.VarChar(120)
  deskripsi String? @db.VarChar(255)

  users     UserPeran[]
  menuAkses MenuPeran[]

  @@map("peran")
}

model User {
  id           BigInt    @id @default(autoincrement())
  orangId      BigInt    @unique @map("orang_id")
  email        String    @unique @db.VarChar(160)
  username     String?   @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  unitScope    String?   @map("unit_scope") @db.VarChar(64)
  aktif        Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  orang Orang       @relation(fields: [orangId], references: [id], onDelete: Cascade)
  peran UserPeran[]

  @@map("user")
}

model UserPeran {
  userId  BigInt @map("user_id")
  peranId Int    @map("peran_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  peran Peran @relation(fields: [peranId], references: [id], onDelete: Cascade)

  @@id([userId, peranId])
  @@map("user_peran")
}

model Menu {
  id     Int     @id @default(autoincrement())
  key    String  @unique @db.VarChar(32)
  label  String  @db.VarChar(120)
  icon   String? @db.VarChar(255)
  urutan Int     @default(0)

  akses MenuPeran[]

  @@map("menu")
}

model MenuPeran {
  menuId  Int @map("menu_id")
  peranId Int @map("peran_id")

  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  peran Peran @relation(fields: [peranId], references: [id], onDelete: Cascade)

  @@id([menuId, peranId])
  @@map("menu_peran")
}

model RelasiWali {
  id        BigInt  @id @default(autoincrement())
  waliId    BigInt  @map("wali_id")
  anakId    BigInt  @map("anak_id")
  hubungan  String  @db.VarChar(48)
  pekerjaan String? @db.VarChar(120)
  utama     Boolean @default(true)

  wali Orang @relation("WaliOrang", fields: [waliId], references: [id], onDelete: Cascade)
  anak Orang @relation("AnakOrang", fields: [anakId], references: [id], onDelete: Cascade)

  @@unique([waliId, anakId])
  @@map("relasi_wali")
}

// ─────────────────────────────────────────────────────────────
// Unit, asrama, kelas
// ─────────────────────────────────────────────────────────────

model Unit {
  id        Int     @id @default(autoincrement())
  key       String  @unique @db.VarChar(24)
  nama      String  @db.VarChar(160)
  deskripsi String? @db.VarChar(255)
  aktif     Boolean @default(true)

  kelas   Kelas[]
  santri  Santri[]
  pegawai Pegawai[]
  jadwal  JadwalPelajaran[]
  ujian   Ujian[]

  @@map("unit")
}

model Kelas {
  id        Int     @id @default(autoincrement())
  unitId    Int     @map("unit_id")
  nama      String  @db.VarChar(32)
  tingkat   String  @db.VarChar(16)
  waliKelas String? @map("wali_kelas") @db.VarChar(160)

  unit        Unit          @relation(fields: [unitId], references: [id])
  santri      Santri[]
  jadwalUjian JadwalUjian[]
  sesiCbt     SesiCbt[]

  @@unique([unitId, nama])
  @@map("kelas")
}

model Asrama {
  id        Int          @id @default(autoincrement())
  nama      String       @unique @db.VarChar(120)
  jk        JenisKelamin
  kapasitas Int          @default(0)
  musyrif   String?      @db.VarChar(160)

  kamar Kamar[]

  @@map("asrama")
}

model Kamar {
  id        Int    @id @default(autoincrement())
  asramaId  Int    @map("asrama_id")
  kode      String @db.VarChar(16)
  kapasitas Int    @default(0)

  asrama Asrama   @relation(fields: [asramaId], references: [id], onDelete: Cascade)
  santri Santri[]

  @@unique([asramaId, kode])
  @@map("kamar")
}

// ─────────────────────────────────────────────────────────────
// Santri & pegawai (peran dari Orang)
// ─────────────────────────────────────────────────────────────

enum StatusSantri {
  Mukim
  Kalong
  Alumni
  Keluar
}

model Santri {
  id         BigInt       @id @default(autoincrement())
  orangId    BigInt       @unique @map("orang_id")
  nis        String       @unique @db.VarChar(32)
  nisn       String?      @unique @db.VarChar(32)
  unitId     Int?         @map("unit_id")
  kelasId    Int?         @map("kelas_id")
  kamarId    Int?         @map("kamar_id")
  status     StatusSantri @default(Mukim)
  program    String?      @db.VarChar(64)
  tahunMasuk String?      @map("tahun_masuk") @db.VarChar(8)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  orang Orang  @relation(fields: [orangId], references: [id], onDelete: Cascade)
  unit  Unit?  @relation(fields: [unitId], references: [id])
  kelas Kelas? @relation(fields: [kelasId], references: [id])
  kamar Kamar? @relation(fields: [kamarId], references: [id])

  hafalan    Hafalan[]
  tazir      Tazir[]
  izin       Izin[]
  presensi   Presensi[]
  tagihan    Tagihan[]
  rekamMedis RekamMedis[]
  nilai      Nilai[]
  kunjungan  Kunjungan[]
  nilaiUjian NilaiUjian[]
  pesertaCbt PesertaCbt[]

  @@index([status])
  @@map("santri")
}

model Pegawai {
  id        BigInt   @id @default(autoincrement())
  orangId   BigInt   @unique @map("orang_id")
  nip       String   @unique @db.VarChar(32)
  unitId    Int?     @map("unit_id")
  jabatan   String   @db.VarChar(120)
  status    String   @db.VarChar(32)
  rekening  String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orang    Orang         @relation(fields: [orangId], references: [id], onDelete: Cascade)
  unit     Unit?         @relation(fields: [unitId], references: [id])
  komponen KomponenGaji?
  slip     SlipGaji[]

  @@map("pegawai")
}

model KomponenGaji {
  pegawaiId   BigInt  @id @map("pegawai_id")
  pokok       Decimal @default(0) @db.Decimal(14, 2)
  tunjJab     Decimal @default(0) @map("tunj_jab") @db.Decimal(14, 2)
  tunjKel     Decimal @default(0) @map("tunj_kel") @db.Decimal(14, 2)
  jamMengajar Int     @default(0) @map("jam_mengajar")
  tarifJam    Decimal @default(0) @map("tarif_jam") @db.Decimal(14, 2)
  transport   Decimal @default(0) @db.Decimal(14, 2)
  bpjs        Decimal @default(0) @db.Decimal(14, 2)
  koperasi    Decimal @default(0) @db.Decimal(14, 2)
  pph         Decimal @default(0) @db.Decimal(14, 2)

  pegawai Pegawai @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)

  @@map("komponen_gaji")
}

model SlipGaji {
  id              BigInt    @id @default(autoincrement())
  pegawaiId       BigInt    @map("pegawai_id")
  periode         String    @db.VarChar(16)
  bruto           Decimal   @db.Decimal(14, 2)
  potongan        Decimal   @db.Decimal(14, 2)
  netto           Decimal   @db.Decimal(14, 2)
  dibayarAt       DateTime? @map("dibayar_at")
  // Revisi setelah pembayaran diizinkan; jejaknya disimpan di sini dan di audit_log.
  status          String    @default("Draft") @db.VarChar(16)
  revisi          Int       @default(0)
  diterbitkanOleh BigInt?   @map("diterbitkan_oleh")
  catatanRevisi   String?   @map("catatan_revisi") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  pegawai Pegawai @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)

  @@unique([pegawaiId, periode])
  @@map("slip_gaji")
}

/// Jejak audit append-only: siapa melakukan apa, kapan, dan nilai apa yang berubah.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  aksi      String   @db.VarChar(48)
  entitas   String   @db.VarChar(48)
  entitasId String?  @map("entitas_id") @db.VarChar(64)
  ringkasan String   @db.VarChar(255)
  perubahan Json?
  aktorId   BigInt?  @map("aktor_id")
  aktorNama String   @default("anonim") @map("aktor_nama") @db.VarChar(160)
  ip        String?  @db.VarChar(64)
  waktu     DateTime @default(now())

  @@index([waktu])
  @@index([entitas, entitasId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────
// Kepesantrenan
// ─────────────────────────────────────────────────────────────

model Halaqah {
  id      Int    @id @default(autoincrement())
  nama    String @db.VarChar(120)
  ustadz  String @db.VarChar(160)
  waktu   String @db.VarChar(64)
  tempat  String @db.VarChar(120)
  jenjang String @db.VarChar(64)
  anggota Int    @default(0)

  @@map("halaqah")
}

model Hafalan {
  id       BigInt   @id @default(autoincrement())
  santriId BigInt   @map("santri_id")
  tgl      DateTime @db.Date
  surat    String   @db.VarChar(64)
  ayat     String   @db.VarChar(32)
  jenis    String   @db.VarChar(32)
  nilai    String   @db.VarChar(32)
  penguji  String   @db.VarChar(160)

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([santriId, tgl])
  @@map("hafalan")
}

model Tazir {
  id          BigInt   @id @default(autoincrement())
  santriId    BigInt   @map("santri_id")
  tgl         DateTime @db.Date
  pelanggaran String   @db.VarChar(255)
  poin        Int      @default(0)
  sanksi      String?  @db.VarChar(255)
  petugas     String   @db.VarChar(160)

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([santriId, tgl])
  @@map("tazir")
}

enum StatusIzin {
  Menunggu
  Disetujui
  Ditolak
  Selesai
}

model Izin {
  id        BigInt     @id @default(autoincrement())
  kode      String     @unique @db.VarChar(24)
  santriId  BigInt     @map("santri_id")
  jenis     String     @db.VarChar(64)
  alasan    String     @db.VarChar(255)
  penjemput String?    @db.VarChar(160)
  keluarAt  DateTime   @map("keluar_at")
  kembaliAt DateTime?  @map("kembali_at")
  status    StatusIzin @default(Menunggu)

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("izin")
}

enum StatusHadir {
  Hadir
  Sakit
  Izin
  Alpa
}

model Presensi {
  id       BigInt      @id @default(autoincrement())
  santriId BigInt      @map("santri_id")
  tgl      DateTime    @db.Date
  sesi     String      @db.VarChar(32)
  status   StatusHadir @default(Hadir)
  ket      String?     @db.VarChar(255)

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([santriId, tgl, sesi])
  @@map("presensi")
}

model KegiatanHarian {
  id     Int     @id @default(autoincrement())
  jam    String  @db.VarChar(16)
  nama   String  @db.VarChar(160)
  ket    String? @db.VarChar(255)
  urutan Int     @default(0)

  @@map("kegiatan_harian")
}

// ─────────────────────────────────────────────────────────────
// Akademik
// ─────────────────────────────────────────────────────────────

model MataPelajaran {
  id        Int     @id @default(autoincrement())
  kode      String  @unique @db.VarChar(24)
  nama      String  @db.VarChar(160)
  jp        Int     @default(0)
  kelompok  String  @db.VarChar(64)
  guru      String? @db.VarChar(160)
  kkm       Int     @default(75)
  kurikulum String? @db.VarChar(64)

  nilai       Nilai[]
  capaian     CapaianPembelajaran[]
  jadwalUjian JadwalUjian[]
  soal        Soal[]
  paketSoal   PaketSoal[]

  @@map("mata_pelajaran")
}

model PerangkatAjar {
  id        Int    @id @default(autoincrement())
  kode      String @unique @db.VarChar(24)
  mapel     String @db.VarChar(160)
  kelas     String @db.VarChar(32)
  jenis     String @db.VarChar(64)
  topik     String @db.VarChar(200)
  pertemuan Int    @default(0)
  guru      String @db.VarChar(160)
  status    String @default("Draf") @db.VarChar(32)

  @@map("perangkat_ajar")
}

model CapaianPembelajaran {
  id      Int    @id @default(autoincrement())
  kode    String @unique @db.VarChar(24)
  mapelId Int?   @map("mapel_id")
  mapel   String @db.VarChar(160)
  fase    String @db.VarChar(32)
  capaian String @db.Text

  mataPelajaran MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@map("capaian_pembelajaran")
}

model BankSoal {
  id      Int    @id @default(autoincrement())
  kode    String @unique @db.VarChar(24)
  mapel   String @db.VarChar(160)
  topik   String @db.VarChar(200)
  tipe    String @db.VarChar(64)
  level   String @db.VarChar(64)
  butir   Int    @default(0)
  dipakai Int    @default(0)
  penulis String @db.VarChar(160)

  @@map("bank_soal")
}

model Nilai {
  id       BigInt  @id @default(autoincrement())
  santriId BigInt  @map("santri_id")
  mapelId  Int     @map("mapel_id")
  periode  String  @db.VarChar(24)
  tugas    Decimal @default(0) @db.Decimal(5, 2)
  uts      Decimal @default(0) @db.Decimal(5, 2)
  uas      Decimal @default(0) @db.Decimal(5, 2)
  akhir    Decimal @default(0) @db.Decimal(5, 2)
  predikat String? @db.VarChar(8)

  santri Santri        @relation(fields: [santriId], references: [id], onDelete: Cascade)
  mapel  MataPelajaran @relation(fields: [mapelId], references: [id])

  @@unique([santriId, mapelId, periode])
  @@map("nilai")
}

model JadwalPelajaran {
  id     Int     @id @default(autoincrement())
  hari   String  @db.VarChar(16)
  jamKe  Int     @map("jam_ke")
  waktu  String  @db.VarChar(32)
  mapel  String  @db.VarChar(160)
  guru   String? @db.VarChar(160)
  kelas  String? @db.VarChar(32)
  /// Tempat pelajaran berlangsung. Terpisah dari `kelas`: importir lama menyimpan
  /// ruangan ("Lab IPA", "Musholla") di kolom kelas, sehingga guru yang mengajar
  /// di luar ruang kelas kehilangan rombongan belajarnya.
  ruang  String? @db.VarChar(64)
  /// Unit tempat jam ini diajarkan. Seorang guru lazim mengampu di SMP dan MA
  /// sekaligus, bahkan merangkap ustadz di pondok — tanpa kolom ini, jadwalnya
  /// tercampur dan kartu "Kelas Saya" tak bisa dikelompokkan per unit.
  unitId Int?    @map("unit_id")

  unit Unit? @relation(fields: [unitId], references: [id])

  @@unique([hari, jamKe, kelas])
  @@index([guru])
  @@map("jadwal_pelajaran")
}

/// Satu gelombang ujian (UTS/UAS/ujian pondok) pada satu unit dan periode.
model Ujian {
  id          Int      @id @default(autoincrement())
  kode        String   @unique @db.VarChar(24)
  nama        String   @db.VarChar(160)
  jenis       String   @db.VarChar(32)
  unitId      Int      @map("unit_id")
  tahunAjaran String   @map("tahun_ajaran") @db.VarChar(16)
  semester    String   @db.VarChar(16)
  mulai       DateTime @db.Date
  selesai     DateTime @db.Date
  status      String   @default("Draf") @db.VarChar(24)
  catatan     String?  @db.VarChar(255)

  unit   Unit          @relation(fields: [unitId], references: [id])
  jadwal JadwalUjian[]

  @@index([status])
  @@map("ujian")
}

/// Satu sesi ujian: satu mapel untuk satu kelas, dengan pengawasnya.
model JadwalUjian {
  id       Int      @id @default(autoincrement())
  ujianId  Int      @map("ujian_id")
  mapelId  Int      @map("mapel_id")
  kelasId  Int      @map("kelas_id")
  tgl      DateTime @db.Date
  waktu    String   @db.VarChar(32)
  durasi   Int      @default(90)
  ruang    String?  @db.VarChar(64)
  pengawas String?  @db.VarChar(160)

  ujian Ujian         @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  mapel MataPelajaran @relation(fields: [mapelId], references: [id])
  kelas Kelas         @relation(fields: [kelasId], references: [id])
  nilai NilaiUjian[]
  sesiCbt SesiCbt[]

  @@unique([ujianId, mapelId, kelasId])
  @@map("jadwal_ujian")
}

/// Hasil satu santri pada satu sesi ujian. Terpisah dari `Nilai` yang menyimpan
/// rekap rapor per periode: di sini nilainya per sesi, lengkap dengan kehadiran.
model NilaiUjian {
  id       BigInt  @id @default(autoincrement())
  jadwalId Int     @map("jadwal_id")
  santriId BigInt  @map("santri_id")
  nilai    Decimal @default(0) @db.Decimal(5, 2)
  hadir    Boolean @default(true)
  catatan  String? @db.VarChar(255)

  jadwal JadwalUjian @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  santri Santri      @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([jadwalId, santriId])
  @@map("nilai_ujian")
}

model KursusLms {
  id         Int    @id @default(autoincrement())
  kode       String @unique @db.VarChar(24)
  nama       String @db.VarChar(160)
  guru       String @db.VarChar(160)
  modul      Int    @default(0)
  selesai    Int    @default(0)
  tugasAktif Int    @default(0) @map("tugas_aktif")
  nilai      Int    @default(0)

  materi MateriLms[]
  tugas  TugasLms[]

  @@map("kursus_lms")
}

model MateriLms {
  id       Int      @id @default(autoincrement())
  kursusId Int      @map("kursus_id")
  judul    String   @db.VarChar(200)
  tipe     String   @db.VarChar(64)
  status   String   @db.VarChar(64)
  tgl      DateTime @db.Date

  kursus KursusLms @relation(fields: [kursusId], references: [id], onDelete: Cascade)

  @@map("materi_lms")
}

model TugasLms {
  id       Int      @id @default(autoincrement())
  kode     String   @unique @db.VarChar(24)
  kursusId Int      @map("kursus_id")
  judul    String   @db.VarChar(200)
  deadline DateTime @db.DateTime
  status   String   @db.VarChar(64)

  kursus KursusLms @relation(fields: [kursusId], references: [id], onDelete: Cascade)

  @@map("tugas_lms")
}

// ─────────────────────────────────────────────────────────────
// Poskestren
// ─────────────────────────────────────────────────────────────

model RekamMedis {
  id           BigInt   @id @default(autoincrement())
  santriId     BigInt   @map("santri_id")
  tgl          DateTime @db.Date
  jam          String?  @db.VarChar(16)
  keluhan      String   @db.VarChar(255)
  diagnosis    String?  @db.VarChar(255)
  terapi       String?  @db.VarChar(255)
  tindakLanjut String?  @map("tindak_lanjut") @db.VarChar(120)
  petugas      String   @db.VarChar(160)

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([santriId, tgl])
  @@map("rekam_medis")
}

model Obat {
  id         Int     @id @default(autoincrement())
  nama       String  @unique @db.VarChar(160)
  satuan     String  @db.VarChar(32)
  kategori   String? @db.VarChar(64)
  stok       Int     @default(0)
  stokMin    Int     @default(0) @map("stok_min")
  kadaluarsa String? @db.VarChar(32)

  @@map("obat")
}

// ─────────────────────────────────────────────────────────────
// Keuangan
// ─────────────────────────────────────────────────────────────

model Tagihan {
  id         BigInt   @id @default(autoincrement())
  kode       String   @unique @db.VarChar(24)
  santriId   BigInt   @map("santri_id")
  jenis      String   @db.VarChar(120)
  periode    String   @db.VarChar(24)
  nominal    Decimal  @db.Decimal(14, 2)
  dibayar    Decimal  @default(0) @db.Decimal(14, 2)
  jatuhTempo DateTime @map("jatuh_tempo") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  santri     Santri       @relation(fields: [santriId], references: [id], onDelete: Cascade)
  pembayaran Pembayaran[]

  @@index([periode])
  @@map("tagihan")
}

model Pembayaran {
  id        BigInt   @id @default(autoincrement())
  tagihanId BigInt   @map("tagihan_id")
  tgl       DateTime @db.Date
  nominal   Decimal  @db.Decimal(14, 2)
  metode    String   @db.VarChar(64)
  ref       String?  @db.VarChar(64)

  tagihan Tagihan @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@map("pembayaran")
}

enum ArahKas {
  Masuk
  Keluar
}

model TransaksiKas {
  id       BigInt   @id @default(autoincrement())
  kode     String   @unique @db.VarChar(24)
  tgl      DateTime @db.Date
  uraian   String   @db.VarChar(255)
  kategori String   @db.VarChar(64)
  metode   String   @db.VarChar(64)
  arah     ArahKas
  nominal  Decimal  @db.Decimal(14, 2)

  @@index([tgl])
  @@map("transaksi_kas")
}

