enum StatusPendaftar {
  Baru
  Verifikasi
  Seleksi
  Lulus
  TidakLulus
  DaftarUlang
}

model Pendaftar {
  id          BigInt          @id @default(autoincrement())
  noReg       String          @unique @map("no_reg") @db.VarChar(32)
  nama        String          @db.VarChar(160)
  jk          JenisKelamin?
  pilihan     String          @db.VarChar(64)
  asalSekolah String?         @map("asal_sekolah") @db.VarChar(160)
